<Window x:Class="DoLLauncher.InstallCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装前检查"
        Icon="pack://application:,,,/Assets/dol.ico"
        Height="560" Width="660" MinHeight="380" MinWidth="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Style="{StaticResource MutedText}"
                   Margin="0,8,0,0" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <StackPanel x:Name="DepsSection">
                    <TextBlock Text="需要补装的前置" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="默认已勾选；取消勾选就只安装主模组，前置需要你自己补。" />
                    <ItemsControl x:Name="DepsList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource ModCheck}"
                                              IsChecked="{Binding Selected, Mode=TwoWay}"
                                              VerticalAlignment="Top" Margin="0,3,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <Border Background="{DynamicResource AccentPaleBrush}" CornerRadius="3"
                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceText}" FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="SatisfiedSection" Margin="0,6,0,0">
                    <TextBlock Text="已满足的前置" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="SatisfiedList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="ConflictSection" Margin="0,14,0,0">
                    <TextBlock Text="可能冲突（本地已装模组）" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="ConflictList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="NotesSection" Margin="0,14,0,0">
                    <TextBlock Text="提示" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="NotesList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,0,0,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock x:Name="EmptyText" Text="没有发现缺失前置，也没有与本地已装模组冲突。"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="FootHint" DockPanel.Dock="Left" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource FlatButton}" Width="92"
                        Click="Cancel_Click" IsCancel="True" />
                <Button Content="开始安装" Style="{StaticResource PrimaryButton}" Width="120"
                        Margin="10,0,0,0" Click="Install_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
