<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DoLLauncher</AssemblyName>
    <RootNamespace>DoLLauncher</RootNamespace>
    <Product>DoL 版本启动器</Product>
    <Version>1.0.0</Version>
    <!-- 版本信息由构建注入为 tag|commit|时间，不再由 SDK 追加 +提交哈希 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dol.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dol.ico" />
    <Resource Include="Assets\dol-favicon.png" />
  </ItemGroup>

</Project>
