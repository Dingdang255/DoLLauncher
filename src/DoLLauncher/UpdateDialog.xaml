<Window x:Class="DoLLauncher.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本DoLLauncher!"
        Icon="pack://application:,,,/Assets/dol.ico"
        Height="580" Width="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="发现新版本DoLLauncher!"
                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Style="{StaticResource MutedText}"
                   Margin="0,8,0,0" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Border x:Name="ChangelogBorder" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <RichTextBox x:Name="ChangelogBox" IsReadOnly="True" IsDocumentEnabled="True"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" />
            </Border>

            <!-- 自动更新失败时的占位：参照剧情页未安装模组的引导样式 -->
            <Border x:Name="FailurePanel" Visibility="Collapsed"
                    Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="启动器自动更新失败" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="FailureText" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="ManualDownloadBtn" Content="前往 GitHub 发布页手动下载"
                                Tag="&#xE774;" Style="{StaticResource IconButton}"
                                Click="ManualDownload_Click" />
                        <Button Content="关闭" Style="{StaticResource FlatButton}" MinWidth="84"
                                Margin="10,0,0,0" Click="Later_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel x:Name="ProgressPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,14,0,0">
            <ProgressBar x:Name="DownloadProgress" Style="{StaticResource ThinProgress}"
                         Maximum="1" Value="0" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}"
                       Margin="0,6,0,0" TextWrapping="Wrap" Text="准备下载…" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <CheckBox x:Name="SkipTodayCheck" Style="{StaticResource TextCheck}"
                      Content="今日内不再提醒" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterBtn" Content="暂不更新" Style="{StaticResource FlatButton}"
                        MinWidth="100" Click="Later_Click" />
                <Button x:Name="UpdateBtn" Content="立即更新" Style="{StaticResource PrimaryButton}"
                        MinWidth="110" Margin="10,0,0,0" Click="Update_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
