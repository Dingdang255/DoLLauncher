<Window x:Class="DoLLauncher.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出为版本包"
        Icon="pack://application:,,,/Assets/dol.ico"
        Height="380" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="导出为 .dolpack" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Style="{StaticResource MutedText}"
                   Margin="0,8,0,0" TextWrapping="Wrap" />

        <CheckBox x:Name="IncludeGameCheck" Grid.Row="2" Style="{StaticResource TextCheck}"
                  IsChecked="True" Margin="0,18,0,0"
                  Content="包含游戏本体与版本文件（Degrees of Lewdity.html 约 62 MB）" />

        <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Margin="27,44,0,0"
                   TextWrapping="Wrap"
                   Text="不勾选时只打包模组清单，别人导入到已有版本里即可用。" />

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="备注（写进 manifest，导入时能看见）" Style="{StaticResource MutedText}" />
            <TextBox x:Name="NoteBox" Style="{StaticResource DarkTextBox}" Margin="0,8,0,0"
                     Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource FlatButton}" Width="92"
                    Click="Cancel_Click" IsCancel="True" />
            <Button Content="导出" Style="{StaticResource PrimaryButton}" Width="110" Margin="10,0,0,0"
                    Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
