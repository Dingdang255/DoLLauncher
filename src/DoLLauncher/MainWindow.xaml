                                                       Margin="0,4,0,9"
                                                       Text="遇到问题或有建议时，可跳转到 GitHub Issue 模板选择页；提交前建议附上诊断页导出的诊断包。" />
                                            <Button Content="打开反馈页" Tag="&#xE774;"
                                                    Style="{StaticResource IconButton}" HorizontalAlignment="Left"
                                                    Click="Feedback_Click" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="检查更新" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="从 GitHub Release 获取最新版本并与当前版本比较；发现新版本时可展示更新日志并直接下载替换启动器本体。" />
                                            <Button x:Name="CheckUpdateBtn" Content="检查更新" Tag="&#xE895;"
                                                    Style="{StaticResource IconButton}" HorizontalAlignment="Left"
                                                    Click="CheckUpdate_Click" />
                                            <TextBlock x:Name="UpdateStatusText"
                                                       TextWrapping="Wrap" Margin="0,8,0,0">
                                                <TextBlock.Style>
                                                    <!-- 没有状态文本时不占高度，出现文本后再自动撑开 -->
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}"
                                                                         Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
