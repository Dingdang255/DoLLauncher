                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="切换整个界面与（子）窗口标题栏的配色；跟随系统时随 Windows 的亮色 / 深色设置自动变化。" />
                                            <ComboBox x:Name="ThemeBox" Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      Width="236" HorizontalAlignment="Left"
                                                      SelectionChanged="Theme_Changed">
                                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                                <ComboBoxItem Content="亮色" Tag="light" />
                                                <ComboBoxItem Content="深色" Tag="dark" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="主题色" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="自定义强调色（按钮、选中态、分页头等）。可直接点色块选色，也可用色相 / 饱和度 / 亮度滑块微调；饱和度 100% 为程序推荐的鲜艳度，0% 为灰色。" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="AccentColorButton" Style="{StaticResource FlatButton}"
                                                        Width="56" Height="30" Padding="0"
                                                        ToolTip="点击选择主色" Click="AccentColor_Click" />
                                                <TextBlock x:Name="AccentColorText" Style="{StaticResource MutedText}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                                <Button Content="恢复默认" Style="{StaticResource FlatButton}"
                                                        Padding="12,4,12,4" Margin="12,0,0,0"
                                                        Click="AccentReset_Click" />
                                            </StackPanel>
                                            <TextBlock Text="色相" Style="{StaticResource MutedText}"
                                                       Margin="0,14,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="AccentHueSlider" Width="220"
                                                        Minimum="0" Maximum="360" TickFrequency="1"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="AccentHsl_Changed"
                                                        LostMouseCapture="AccentHsl_LostMouseCapture" />
                                                <TextBlock x:Name="AccentHueText" Style="{StaticResource MutedText}"
                                                           Width="44" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="饱和度" Style="{StaticResource MutedText}"
                                                       Margin="0,10,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="AccentSaturationSlider" Width="220"
                                                        Minimum="0" Maximum="100"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="AccentHsl_Changed"
                                                        LostMouseCapture="AccentHsl_LostMouseCapture" />
                                                <TextBlock x:Name="AccentSaturationText" Style="{StaticResource MutedText}"
                                                           Width="44" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="亮度" Style="{StaticResource MutedText}"
                                                       Margin="0,10,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="AccentLightnessSlider" Width="220"
                                                        Minimum="0" Maximum="100"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="AccentHsl_Changed"
                                                        LostMouseCapture="AccentHsl_LostMouseCapture" />
                                                <TextBlock x:Name="AccentLightnessText" Style="{StaticResource MutedText}"
                                                           Width="44" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="启动器副标题" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="显示在左上角「DoL 启动器」下方的一行小字；留空时使用「版本 · 模组 · 存档」。" />
                                            <TextBox x:Name="SubtitleCustomBox" Style="{StaticResource DarkTextBox}"
                                                     Width="236" HorizontalAlignment="Left"
                                                     MaxLength="32" LostFocus="SubtitleCustom_LostFocus" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="AnimationCheck" Style="{StaticResource TextCheck}"
                                                      Content="启用界面过渡动画" Click="Animation_Checked" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,8,0,0"
                                                       Text="页面切换、按钮悬停、列表刷新、弹窗淡入与滚动都使用平滑过渡；系统关闭「UI 动画」时会自动减弱。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="界面布局" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="把鼠标移到各区域之间的空隙，出现双向箭头时按住拖动即可调整相邻区域的宽或高；拖动结果会被记住。" />
                                            <Button Content="恢复默认布局尺寸" Tag="&#xE777;"
                                                    Style="{StaticResource IconButton}" HorizontalAlignment="Left"
                                                    Click="ResetLayout_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 版本信息 -->
                                <StackPanel x:Name="SettingsVersionPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="启动器版本" FontWeight="SemiBold" />
                                            <TextBlock x:Name="VersionInfoText" Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="正在读取版本信息…" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="ProjectHomeBtn" Content="项目主页" Tag="&#xE774;"
                                                        Style="{StaticResource IconButton}" DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right" Click="ProjectHome_Click" />
                                                <TextBlock Text="致谢名单" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <StackPanel x:Name="CreditsPanel" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="检查更新" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="从 GitHub Release 获取最新版本并与当前版本比较；只读取信息，不会自动下载。" />
                                            <Button x:Name="CheckUpdateBtn" Content="检查更新" Tag="&#xE895;"
                                                    Style="{StaticResource IconButton}" HorizontalAlignment="Left"
                                                    Click="CheckUpdate_Click" />
                                            <TextBlock x:Name="UpdateStatusText"
                                                       TextWrapping="Wrap" Margin="0,8,0,0">
                                                <TextBlock.Style>
                                                    <!-- 没有状态文本时不占高度，出现文本后再自动撑开 -->
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}"
                                                                         Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
