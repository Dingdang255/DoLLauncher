<Window x:Class="DoLLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DoLLauncher.Controls"
        Title="DoL 版本启动器"
        Icon="pack://application:,,,/Assets/dol.ico"
        Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 美化包主窗口背景（没有启用美化包时隐藏） -->
        <Border x:Name="SkinBackdrop" Grid.ColumnSpan="3" IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- 左侧 PCL 式导航 -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,16">
                        <Border x:Name="AvatarHost" Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource AccentPaleBrush}" Cursor="Hand"
                                ToolTip="点击更换玩家头像" MouseLeftButtonUp="Avatar_Click"
                                MouseEnter="Avatar_MouseEnter" MouseLeave="Avatar_MouseLeave">
                            <Border.Clip>
                                <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                            </Border.Clip>
                            <Grid>
                                <Image x:Name="AvatarImage" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- 悬停遮罩：让头像变暗，提示可点击更换 -->
                                <Border x:Name="AvatarHoverMask" Background="#000000" Opacity="0"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DoL 启动器" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="SubtitleText" Text="版本 · 模组 · 存档"
                                       Style="{StaticResource MutedText}" FontSize="10" />
                        </StackPanel>
                    </StackPanel>

                    <RadioButton x:Name="NavVersions" Style="{StaticResource NavItem}" GroupName="MainNav"
                                 Tag="&#xE81E;" Content="版本管理" IsChecked="True"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" GroupName="MainNav"
                                 Tag="&#xE896;" Content="下载中心"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" GroupName="MainNav"
                                 Tag="&#xE74E;" Content="备份"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavStory" Style="{StaticResource NavItem}" GroupName="MainNav"
                                 Tag="&#xE8A9;" Content="剧情"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDiagnostic" Style="{StaticResource NavItem}" GroupName="MainNav"
                                 Tag="&#xE9D9;" Content="诊断"
                                 Checked="Nav_Checked" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="MainNav"
                                 Tag="&#xE713;" Content="设置" Checked="Nav_Checked" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="10"
                               TextWrapping="Wrap" Margin="6,0,6,0"
                               Text="每个版本使用独立端口，存档、模组开关与设置互不干扰。" />
                </StackPanel>
                <Border Background="Transparent" />
            </DockPanel>
        </Border>

        <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="nav.width"
                               DefaultSize="184" MinPrevious="140" MinNext="760"
                               Margin="6,0,-8,0"
                               Style="{StaticResource PaneSplitterStyle}" />

        <Grid Grid.Column="2">
            <!-- ===== 版本管理页 ===== -->
            <Grid x:Name="VersionPage" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="version.listWidth"
                                       DefaultSize="330" MinPrevious="220" MinNext="420"
                                       Style="{StaticResource PaneSplitterStyle}" />

                <!-- 版本列表 -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="2,2,2,10">
                                <TextBlock Text="游戏版本" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="VersionCountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           Style="{StaticResource MutedText}" />
                            </DockPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Button x:Name="AddVersionBtn" Content="添加版本" Tag="&#xE710;"
                                        Style="{StaticResource IconButton}" Margin="0,0,5,0" Click="AddVersion_Click" />
                                <Button x:Name="ImportPackBtn" Content="导入版本/模组包" Tag="&#xE8E5;" FontSize="12"
                                        Style="{StaticResource IconButton}" Margin="5,0,0,0" Click="ImportPack_Click" />
                            </UniformGrid>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}"
                                   Margin="2,10,2,0" TextWrapping="Wrap"
                                   Text="双击版本卡片可直接启动。每个版本的存档、模组开关、设置都由独立端口隔离。" />

                        <Grid x:Name="VersionListHost">
                            <Canvas x:Name="VersionIndicatorLayer" Panel.ZIndex="2" IsHitTestVisible="False" ClipToBounds="True">
                                <Grid x:Name="VersionIndicator" Canvas.Left="3" Canvas.Top="0" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="VersionIndicatorMove" />
                                    </Grid.RenderTransform>
                                    <Path Data="M 0,0 L 7,6 L 0,12 Z" Fill="{DynamicResource AccentBrush}" />
                                    <Path x:Name="IndicatorRunning" Data="M 0,0 L 7,6 L 0,12 Z"
                                          Fill="{DynamicResource RunningBrush}" Opacity="0" />
                                </Grid>
                            </Canvas>

                            <ListBox x:Name="VersionList" Margin="16,0,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                                     HorizontalContentAlignment="Stretch"
                                     ItemContainerStyle="{StaticResource VersionItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False"
                                     SelectionChanged="VersionList_SelectionChanged"
                                     MouseDoubleClick="VersionList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding StatusText}" DockPanel.Dock="Right" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9098A6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                <Setter Property="Foreground" Value="#6ECB8F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Helper">
                                                                <Setter Property="Foreground" Value="#6C9CD9" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Simulating">
                                                                <Setter Property="Foreground" Value="#B39DDB" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Legacy">
                                                                <Setter Property="Foreground" Value="#E0A65C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- 版本详情 -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
                    <Grid x:Name="DetailRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="180" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                        Margin="10,3,0,0">
                                <Border x:Name="OldVersionBadge" Style="{StaticResource WarnBadge}"
                                        Visibility="Collapsed">
                                    <TextBlock Text="版本过旧" FontSize="11"
                                               Foreground="{DynamicResource WarnBrush}" />
                                </Border>
                                <Border Background="{DynamicResource AccentPaleBrush}" CornerRadius="6"
                                        Padding="9,4">
                                    <TextBlock x:Name="BadgeMode" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TitleText" Text="未选择版本" FontSize="21" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SubText" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                            <Button x:Name="LaunchBtn" Content="启动游戏" Tag="&#xE768;"
                                    Style="{StaticResource IconPrimaryButton}"
                                    Click="Launch_Click" Margin="0,0,8,8" />
                            <Button x:Name="ConflictBtn" Content="可能存在问题" Tag="&#xE7BA;"
                                    Style="{StaticResource IconMutedButton}"
                                    Click="Conflict_Click" Margin="0,0,8,8"
                                    ToolTip="检查模组冲突、版本不匹配与缺少前置" />
                            <Button x:Name="StopBtn" Content="停止" Tag="&#xE71A;"
                                    Style="{StaticResource IconButton}"
                                    Click="Stop_Click" Margin="0,0,8,8" />
                            <Button x:Name="SavesBtn" Content="存档助手" Tag="&#xE74E;"
                                    Style="{StaticResource IconButton}"
                                    Click="Saves_Click" Margin="0,0,8,8"
                                    ToolTip="在同一端口打开存档导入/导出页面" />
                            <Button x:Name="ExportBtn" Content="导出版本包" Tag="&#xE7B8;"
                                    Style="{StaticResource IconButton}"
                                    Click="Export_Click" Margin="0,0,8,8"
                                    ToolTip="打包成 .dolpack，别人导入后即可使用" />
                            <Button x:Name="CheckBtn" Content="完整性检查" Tag="&#xE73E;"
                                    Style="{StaticResource IconButton}"
                                    Click="Check_Click" Margin="0,0,8,8" />
                            <Button x:Name="OpenFolderBtn" Content="打开目录" Tag="&#xE8B7;"
                                    Style="{StaticResource IconButton}"
                                    Click="OpenFolder_Click" Margin="0,0,8,8" />
                            <Button x:Name="DeleteBtn" Content="删除版本" Tag="&#xE74D;"
                                    Style="{StaticResource IconDangerButton}"
                                    Click="Delete_Click" Margin="0,0,0,8" />
                        </WrapPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,14">
                            <TextBlock x:Name="PathText" Style="{StaticResource MutedText}"
                                       FontFamily="Consolas" TextWrapping="Wrap" />
                            <DockPanel x:Name="LegacyTargetPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="打开版本" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <ComboBox x:Name="LegacyTargetBox" Width="240" Margin="10,0,0,0"
                                          Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          ItemTemplate="{StaticResource VersionComboTemplate}"
                                          SelectionChanged="LegacyTarget_Changed"
                                          ToolTip="旧版 file:// 数据固定打开这个版本的 html" />
                            </DockPanel>
                        </StackPanel>

                        <DockPanel Grid.Row="3">
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ImportModBtn" Content="导入" Style="{StaticResource TinyButton}" Width="52"
                                        Click="ImportMod_Click" ToolTip="导入模组 zip（也可以直接把 zip 拖进下面的列表）" />
                                <Button x:Name="ModDetailBtn" Content="详情" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="ModDetail_Click" />
                                <Button x:Name="RenameModBtn" Content="重命名" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="RenameMod_Click" />
                                <Button x:Name="DeleteModBtn" Content="删除" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="DeleteMod_Click"
                                        ToolTip="删除选中的模组（可多选）" />
                                <Button x:Name="BatchEnableBtn" Content="启用" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="BatchEnable_Click"
                                        ToolTip="启用选中的所有模组" />
                                <Button x:Name="BatchDisableBtn" Content="停用" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="BatchDisable_Click"
                                        ToolTip="停用选中的所有模组" />
                                <Button x:Name="RefreshModsBtn" Content="刷新" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="RefreshMods_Click" />
                                <Button x:Name="EmbeddedModsBtn" Content="内置" Style="{StaticResource TinyButton}" Width="52"
                                        Margin="6,0,0,0" Click="EmbeddedMods_Click"
                                        ToolTip="查看整合包 HTML 内置的模组（只读）" />
                            </WrapPanel>
                            <TextBlock Text="模组" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModCountText" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Grid.Row="4" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,4" />

                        <Grid Grid.Row="5" ClipToBounds="True">
                        <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0" Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource ModItem}"
                                 AllowDrop="True" DragOver="ModList_DragOver" Drop="ModList_Drop"
                                 SelectionMode="Extended"
                                 MouseDoubleClick="ModList_MouseDoubleClick"
                                 SelectionChanged="ModList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="ModList_PreviewLeftDown"
                                 PreviewMouseMove="ModList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="ModList_PreviewMouseLeftButtonUp"
                                 LostMouseCapture="ModList_LostMouseCapture"
                                 PreviewMouseRightButtonDown="ModList_PreviewRightDown"
                                 PreviewKeyDown="ModList_PreviewKeyDown"
                                 ToolTip="点一行选中；Ctrl / Shift 多选；Ctrl+A 全选；按住行可拖动排序"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="查看详情" Click="ModDetail_Click" />
                                                <MenuItem Header="重命名…" Click="RenameMod_Click" />
                                                <Separator />
                                                <MenuItem Header="启用所选" Click="BatchEnable_Click" />
                                                <MenuItem Header="停用所选" Click="BatchDisable_Click" />
                                                <Separator />
                                                <MenuItem Header="提前加载" Click="ModMenuUp_Click" />
                                                <MenuItem Header="延后加载" Click="ModMenuDown_Click" />
                                                <MenuItem Header="打开模组所在位置" Click="ModMenuOpenFolder_Click" />
                                                <Separator />
                                                <MenuItem Header="删除所选" Foreground="{DynamicResource DangerBrush}"
                                                          Click="DeleteMod_Click" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Style="{StaticResource ModCheck}"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      PreviewMouseLeftButtonDown="ModCheck_PreviewDown"
                                                      ToolTip="只控制启用/停用；选中模组请点这一行" />
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" Width="38">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding IssueText}" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IssueText.Length}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ConflictText}" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConflictText.Length}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="↑" Style="{StaticResource TinyButton}" Click="ModUp_Click"
                                                    ToolTip="提前加载" />
                                            <Button Content="↓" Style="{StaticResource TinyButton}" Click="ModDown_Click"
                                                    Margin="6,0,0,0" ToolTip="延后加载" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 拖动排序时的插入位置指示线 -->
                        <Border x:Name="ModDragLine" Height="2" VerticalAlignment="Top"
                                Margin="4,0,4,0" Background="#3C3C3C"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>

                        <controls:PaneSplitter Grid.Row="6" Axis="Rows" SettingKey="version.logHeight"
                                               DefaultSize="180" MinPrevious="160" MinNext="120"
                                               Style="{StaticResource PaneSplitterStyle}" />

                        <Grid Grid.Row="7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="运行记录" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource DarkTextBox}"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 下载中心页 ===== -->
            <Grid x:Name="DownloadPage" Visibility="Collapsed" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="download.navWidth"
                                       DefaultSize="212" MinPrevious="170" MinNext="520"
                                       Style="{StaticResource PaneSplitterStyle}" />

                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="下载中心" FontSize="16" FontWeight="SemiBold" Margin="6,2,0,10" />

                            <RadioButton x:Name="DownloadNavGame" Style="{StaticResource NavSubItem}" GroupName="DlNav"
                                         Tag="&#xE774;" Content="游戏本体" IsChecked="True"
                                         Checked="DownloadNav_Checked" />
                            <RadioButton x:Name="DownloadNavMod" Style="{StaticResource NavSubItem}" GroupName="DlNav"
                                         Tag="&#xE7B8;" Content="模组市场"
                                         Checked="DownloadNav_Checked" />
                            <RadioButton x:Name="DownloadNavPack" Style="{StaticResource NavSubItem}" GroupName="DlNav"
                                         Tag="&#xE8F1;" Content="整合包"
                                         Checked="DownloadNav_Checked" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,12" />

                            <!-- 只有模组下载才需要选择目标版本 -->
                            <StackPanel x:Name="MarketTargetPanel" Visibility="Collapsed">
                                <TextBlock Text="安装到版本" Style="{StaticResource MutedText}" Margin="8,0,0,6" />
                                <ComboBox x:Name="MarketTargetBox" Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          Margin="4,0,4,0" SelectionChanged="MarketTarget_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ComboName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="RefreshMarketBtn" Style="{StaticResource IconButton}" Tag="&#xE72C;"
                                    Content="刷新列表" Margin="4,10,4,0" Click="RefreshMarket_Click" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" FontSize="10"
                                   TextWrapping="Wrap" Margin="6,12,6,0"
                                   Text="本体可选汉化整包或 ModLoader Neo 单文件，均来自 GitHub Release；整合包目前支持 Lyra；模组索引来自 ModHub 市场。安装后会自动重建 modList.json。" />

                        <!-- 分类底下的下载列表：一个文件一条任务，底部按钮取消选中的任务 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="下载列表" FontSize="13" FontWeight="SemiBold"
                                       Margin="6,0,0,6" />
                            <ListBox x:Name="DownloadTaskList" Grid.Row="1" Background="Transparent"
                                     BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                     ItemContainerStyle="{StaticResource DownloadItem}"
                                     SelectionChanged="DownloadTaskList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <ProgressBar Style="{StaticResource ThinProgress}" Maximum="1"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         Margin="0,5,0,4" />
                                            <TextBlock Text="{Binding InfoText}" Style="{StaticResource MutedText}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding InfoText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 没有下载任务时的空状态提示 -->
                            <TextBlock x:Name="DownloadEmptyHint" Grid.Row="1" Style="{StaticResource MutedText}"
                                       FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Left"
                                       Margin="6,2,0,0" TextWrapping="Wrap"
                                       Text="当前还没有正在进行的下载任务" />
                            <Button x:Name="CancelDownloadBtn" Grid.Row="2" Tag="&#xE711;" Content="取消下载"
                                    Style="{StaticResource IconButton}" Margin="4,10,4,0"
                                    Visibility="Collapsed" Click="CancelDownload_Click" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="150" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <!-- 本体下载 -->
                            <Grid x:Name="GamePane">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="游戏本体下载" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="GameSourceHintText" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                                    <WrapPanel>
                                        <TextBlock Text="游戏源" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox x:Name="GameSourceBox" Width="260" Style="{StaticResource FlatCombo}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                                  SelectionChanged="GameSource_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel x:Name="GamePager" Orientation="Horizontal" Margin="16,0,0,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource TinyButton}"
                                                    VerticalAlignment="Center" ToolTip="上一页"
                                                    Click="GamePagePrev_Click" />
                                            <TextBox x:Name="GamePageBox" Width="42" Margin="8,0,6,0"
                                                     Style="{StaticResource DarkTextBox}" Padding="4,2"
                                                     FontSize="12" TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="GamePageBox_KeyDown" LostFocus="GamePageBox_LostFocus"
                                                     Text="1" ToolTip="输入页码后回车跳转" />
                                            <TextBlock x:Name="GamePageTotal" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="/ 1" />
                                            <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource TinyButton}"
                                                    VerticalAlignment="Center" ToolTip="下一页"
                                                    Click="GamePageNext_Click" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox x:Name="PolyfillCheck" Style="{StaticResource TextCheck}"
                                                  Content="使用 polyfill 版本" Margin="0,0,20,0" />
                                        <CheckBox x:Name="I18nCheck" Style="{StaticResource TextCheck}"
                                                  Content="同时安装 ModI18N 汉化模组" IsChecked="True" Margin="0,0,20,0" />
                                        <CheckBox x:Name="ImagePackCheck" Style="{StaticResource TextCheck}"
                                                  Content="同时安装原版图片包" IsChecked="True" />
                                    </WrapPanel>
                                </StackPanel>

                                <ListBox x:Name="GameReleaseList" Grid.Row="2" Background="Transparent"
                                         BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource DownloadItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding BadgeText}" DockPanel.Dock="Right"
                                                               FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <Border Style="{StaticResource LegacyBadge}" DockPanel.Dock="Right">
                                                        <TextBlock Text="版本过旧" FontSize="11"
                                                                   Foreground="{DynamicResource WarnBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding AssetSummary}" Style="{StaticResource MutedText}"
                                                           FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="GameDownloadBtn" Style="{StaticResource IconPrimaryButton}"
                                            Tag="&#xE896;" Content="下载并安装" Click="DownloadGame_Click" />
                                    <TextBlock x:Name="GameStatusText" Style="{StaticResource MutedText}"
                                               Margin="12,0,0,0" />
                                </StackPanel>

                                <ProgressBar x:Name="GameProgress" Grid.Row="4" Style="{StaticResource ThinProgress}"
                                             Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
                            </Grid>

                            <!-- 模组市场 -->
                            <Grid x:Name="ModPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="模组市场" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MarketHintText" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Text="索引来自 ModHub 市场；会标出已安装/可更新，安装前检查前置与本地冲突，可勾选同步补装，并可选择历史版本。" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="260">
                                        <TextBox x:Name="MarketSearchBox" Style="{StaticResource DarkTextBox}"
                                                 TextChanged="MarketSearch_TextChanged" />
                                        <TextBlock Text="搜索模组名 / 作者 / 标签 / 简介" IsHitTestVisible="False"
                                                   Margin="17,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text.Length, ElementName=MarketSearchBox}"
                                                                     Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ComboBox x:Name="MarketCategoryBox" Style="{StaticResource FlatCombo}"
                                              ItemContainerStyle="{StaticResource FlatComboItem}"
                                              Width="150" Margin="10,0,0,0"
                                              SelectionChanged="MarketCategory_Changed" />
                                    <ComboBox x:Name="MarketFilterBox" Style="{StaticResource FlatCombo}"
                                              ItemContainerStyle="{StaticResource FlatComboItem}"
                                              Width="132" Margin="10,0,0,0"
                                              SelectionChanged="MarketFilter_Changed">
                                        <ComboBoxItem Content="全部模组" IsSelected="True" />
                                        <ComboBoxItem Content="未安装" />
                                        <ComboBoxItem Content="可更新" />
                                    </ComboBox>
                                    <TextBlock x:Name="MarketCountText" Style="{StaticResource MutedText}"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="匹配" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <ComboBox x:Name="MarketMatchBox" Style="{StaticResource FlatCombo}"
                                              ItemContainerStyle="{StaticResource FlatComboItem}" Width="150"
                                              SelectionChanged="MarketAdvanced_Changed">
                                        <ComboBoxItem Content="部分匹配" Tag="contains" IsSelected="True" />
                                        <ComboBoxItem Content="完全匹配" Tag="exact" />
                                    </ComboBox>
                                    <TextBlock Text="范围" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               Margin="12,0,6,0" />
                                    <ComboBox x:Name="MarketScopeBox" Style="{StaticResource FlatCombo}"
                                              ItemContainerStyle="{StaticResource FlatComboItem}" Width="96"
                                              SelectionChanged="MarketAdvanced_Changed">
                                        <ComboBoxItem Content="全部" Tag="all" IsSelected="True" />
                                        <ComboBoxItem Content="标题" Tag="title" />
                                        <ComboBoxItem Content="作者" Tag="author" />
                                        <ComboBoxItem Content="简介" Tag="description" />
                                        <ComboBoxItem Content="标签" Tag="tag" />
                                    </ComboBox>
                                    <TextBlock Text="排序" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                               Margin="12,0,6,0" />
                                    <ComboBox x:Name="MarketSortBox" Style="{StaticResource FlatCombo}"
                                              ItemContainerStyle="{StaticResource FlatComboItem}" Width="126"
                                              SelectionChanged="MarketAdvanced_Changed">
                                        <ComboBoxItem Content="默认排序" Tag="default" IsSelected="True" />
                                        <ComboBoxItem Content="最近更新" Tag="updated" />
                                        <ComboBoxItem Content="名称" Tag="name" />
                                    </ComboBox>
                                    <CheckBox x:Name="MarketSortDescCheck" Style="{StaticResource TextCheck}"
                                              Content="倒序" Margin="10,0,0,0" Click="MarketSortDesc_Changed" />
                                </DockPanel>
                                </StackPanel>

                                <ListBox x:Name="MarketList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                         Padding="0" HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource DownloadItem}"
                                         SelectionChanged="MarketList_SelectionChanged"
                                         PreviewMouseLeftButtonDown="MarketList_PreviewLeftDown"
                                         MouseDoubleClick="MarketList_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource ModCheck}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Click="MarketCheck_Click"
                                                          VerticalAlignment="Top" Margin="0,3,10,0"
                                                          ToolTip="勾选后可批量安装" />
                                                <StackPanel Grid.Column="1">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Mod.Subtitle}" DockPanel.Dock="Right"
                                                               Style="{StaticResource MutedText}" FontSize="11"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    <Border DockPanel.Dock="Right" Background="{DynamicResource AccentPaleBrush}"
                                                            CornerRadius="5" Padding="7,2" Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Mod.BadgeText.Length}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Mod.BadgeText}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Mod.Name}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Mod.Description}" Style="{StaticResource MutedText}"
                                                           FontSize="11" Margin="0,4,0,0" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 控件超宽时被裁剪在行内，按住 Shift + 滚轮可左右移动 -->
                                <ScrollViewer Grid.Row="3" Style="{StaticResource RowScroller}" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                    <Button x:Name="MarketDownloadBtn" Style="{StaticResource IconPrimaryButton}"
                                            Tag="&#xE896;" Content="下载并安装" Click="DownloadMod_Click" />
                                    <ComboBox x:Name="MarketVersionBox" Style="{StaticResource FlatCombo}"
                                              ItemContainerStyle="{StaticResource FlatComboItem}"
                                              ItemTemplate="{StaticResource ReleaseComboTemplate}"
                                              Width="150" Margin="10,0,0,0"
                                              SelectionChanged="MarketVersion_SelectionChanged"
                                              ToolTip="选择要安装的历史 Release（共享仓库的 mod / facemod 等 tag 代表不同产品）" />
                                    <StackPanel x:Name="MarketEditionPanel" Orientation="Horizontal"
                                                Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="包型" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="MarketEditionBox" Style="{StaticResource FlatCombo}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                                  ItemTemplate="{StaticResource EditionComboTemplate}"
                                                  Width="170"
                                                  SelectionChanged="MarketEdition_SelectionChanged"
                                                  ToolTip="同一个模组的不同包型 / 包体系列" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="包版本" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="MarketAssetBox" Style="{StaticResource FlatCombo}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                                  ItemTemplate="{StaticResource EditionComboTemplate}"
                                                  Width="110"
                                                  SelectionChanged="MarketAsset_SelectionChanged"
                                                  ToolTip="这个包型下的具体版本，默认选最新" />
                                    </StackPanel>
                                    <Button x:Name="MarketVersionBtn" Style="{StaticResource IconButton}" Tag="&#xE72C;"
                                            Content="加载版本" Margin="8,0,0,0" Click="LoadModReleases_Click" />
                                    <TextBlock x:Name="MarketBatchHint" Style="{StaticResource MutedText}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock x:Name="MarketStatusText" Style="{StaticResource MutedText}"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ScrollViewer>

                                <ProgressBar x:Name="MarketProgress" Grid.Row="4" Style="{StaticResource ThinProgress}"
                                             Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
                            </Grid>

                            <!-- 整合包 -->
                            <Grid x:Name="PackPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="整合包下载" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PackHintText" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Text="目前支持 Lyra 整合包。下载后自动生成独立版本，可再选择把普通模组解压到 mods/ 以便启停和排序。" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,14,0,10">
                                    <WrapPanel>
                                        <TextBlock Text="整合包类型" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox x:Name="PackTypeBox" Width="220" Style="{StaticResource FlatCombo}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                                  SelectionChanged="PackType_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,10,0,0">
                                        <TextBlock Text="整合包版本" Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox x:Name="PackReleaseBox" Width="300" Style="{StaticResource FlatCombo}"
                                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                                  ToolTip="选择要查看的 Release"
                                                  SelectionChanged="PackRelease_Changed">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding ReleaseTip}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel x:Name="PackPager" Orientation="Horizontal" Margin="16,0,0,0"
                                                    VerticalAlignment="Center" Visibility="Collapsed">
                                            <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource TinyButton}"
                                                    VerticalAlignment="Center" ToolTip="上一页"
                                                    Click="PackPagePrev_Click" />
                                            <TextBox x:Name="PackPageBox" Width="42" Margin="8,0,6,0"
                                                     Style="{StaticResource DarkTextBox}" Padding="4,2"
                                                     FontSize="12" TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="PackPageBox_KeyDown" LostFocus="PackPageBox_LostFocus"
                                                     Text="1" ToolTip="输入页码后回车跳转" />
                                            <TextBlock x:Name="PackPageTotal" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" Text="/ 1" />
                                            <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                    Style="{StaticResource TinyButton}"
                                                    VerticalAlignment="Center" ToolTip="下一页"
                                                    Click="PackPageNext_Click" />
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>

                                <ListBox x:Name="PackVariantList" Grid.Row="2" Background="Transparent"
                                         BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                         ScrollViewer.CanContentScroll="False"
                                         ItemContainerStyle="{StaticResource DownloadItem}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <DockPanel>
                                                    <Border Style="{StaticResource LegacyBadge}" DockPanel.Dock="Right">
                                                        <TextBlock Text="版本过旧" FontSize="11"
                                                                   Foreground="{DynamicResource WarnBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                           FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <ProgressBar x:Name="PackProgress" Grid.Row="3" Style="{StaticResource ThinProgress}"
                                             Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
                                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                                    <Button x:Name="PackDownloadBtn" DockPanel.Dock="Right" Content="下载整合包"
                                            Tag="&#xE896;" Style="{StaticResource IconButton}"
                                            Click="DownloadPack_Click" MinWidth="130" />
                                    <TextBlock x:Name="PackStatusText" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                        </Grid>

                        <controls:PaneSplitter Grid.Row="1" Axis="Rows" SettingKey="download.logHeight"
                                               DefaultSize="150" MinPrevious="200" MinNext="100"
                                               Style="{StaticResource PaneSplitterStyle}" />

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="运行记录" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                            <TextBox x:Name="DownloadLogBox" Grid.Row="1" Style="{StaticResource DarkTextBox}"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     Foreground="{DynamicResource MutedBrush}"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 备份页 ===== -->
            <Grid x:Name="BackupPage" Visibility="Collapsed" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="backup.leftWidth"
                                       DefaultSize="340" MinPrevious="240" MinNext="420"
                                       Style="{StaticResource PaneSplitterStyle}" />

                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="备份" FontSize="16" FontWeight="SemiBold" Margin="2,2,0,12" />

                            <TextBlock Text="目标版本" Style="{StaticResource MutedText}" Margin="2,0,0,6" />
                            <ComboBox x:Name="BackupTargetBox" Style="{StaticResource FlatCombo}"
                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                      Margin="0,0,0,12" SelectionChanged="BackupTarget_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ComboName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button x:Name="BackupOpenSavesBtn" Content="打开存档助手" Tag="&#xE74E;"
                                    Style="{StaticResource IconButton}" Click="BackupOpenSaves_Click"
                                    ToolTip="多槽批量导入/导出、单槽管理与启动器里的存档备份" />
                            <Button x:Name="BackupSavesNowBtn" Content="立即备份存档" Tag="&#xE896;"
                                    Style="{StaticResource IconButton}" Click="BackupSavesNow_Click" Margin="0,8,0,0"
                                    ToolTip="直接用页面写回的磁盘镜像备份，不打开浏览器窗口" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

                            <Button x:Name="ExportModsConfigBtn" Content="导出模组配置" Tag="&#xE8B7;"
                                    Style="{StaticResource IconButton}" Click="ExportModsConfig_Click" />
                            <Button x:Name="RestoreModsConfigBtn" Content="还原模组配置" Tag="&#xE8E5;"
                                    Style="{StaticResource IconButton}" Click="RestoreModsConfig_Click" Margin="0,8,0,0" />
                            <Button x:Name="CreateSnapshotBtn" Content="创建整版快照" Tag="&#xE7B8;"
                                    Style="{StaticResource IconButton}" Click="CreateSnapshot_Click" Margin="0,8,0,0" />
                            <CheckBox x:Name="SnapshotGameCheck" Style="{StaticResource TextCheck}"
                                      Content="快照包含游戏本体（体积大，还原时可当新版本导入）" Margin="4,8,0,0" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

                            <CheckBox x:Name="AutoBackupCheck" Style="{StaticResource TextCheck}"
                                      Content="启动时自动备份模组与配置" Click="AutoBackup_Checked" />
                            <CheckBox x:Name="AutoSaveCheck" Style="{StaticResource TextCheck}"
                                      Content="启动时自动备份浏览器存档（会短暂打开备份页）"
                                      Click="AutoSave_Checked" Margin="0,10,0,0" />
                            <DockPanel Margin="4,10,0,0">
                                <TextBlock Text="快照/自动备份保留份数" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="BackupKeepBox" Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          Width="72" Margin="10,0,0,0" SelectionChanged="BackupKeep_Changed">
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="5" IsSelected="True" />
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                </ComboBox>
                            </DockPanel>
                            <TextBlock x:Name="BackupMirrorText" Style="{StaticResource MutedText}" FontSize="10"
                                       TextWrapping="Wrap" Margin="2,8,2,0"
                                       Text="磁盘镜像：等待读取…" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" FontSize="10"
                                   TextWrapping="Wrap" Margin="2,12,2,0"
                                   Text="备份都放在启动器根目录的 backups\版本名 下，不会污染游戏目录。存档镜像由游戏页自动写回磁盘，备份/还原都不需要打开浏览器。" />
                        <Border Background="Transparent" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock x:Name="BackupCountText" DockPanel.Dock="Right"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Text="备份列表" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="双击快照可直接导入；模组配置会按文件里的顺序还原。" />
                        </DockPanel>

                        <ListBox x:Name="BackupList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Padding="0" HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource DownloadItem}"
                                 MouseDoubleClick="BackupList_MouseDoubleClick"
                                 SelectionChanged="BackupList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right"
                                                       Style="{StaticResource MutedText}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <Border Background="{DynamicResource AccentPaleBrush}" CornerRadius="5"
                                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}"
                                                   FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="RestoreBackupBtn" Content="还原所选备份" Tag="&#xE777;"
                                    Style="{StaticResource IconPrimaryButton}" Click="RestoreBackup_Click"
                                    Margin="0,0,8,8" />
                            <Button x:Name="DeleteBackupBtn" Content="删除" Tag="&#xE74D;"
                                    Style="{StaticResource IconDangerButton}" Click="DeleteBackup_Click"
                                    Margin="0,0,8,8" />
                            <Button x:Name="OpenBackupFolderBtn" Content="打开备份目录" Tag="&#xE8B7;"
                                    Style="{StaticResource IconButton}" Click="OpenBackupFolder_Click"
                                    Margin="0,0,8,8" />
                            <Button x:Name="RefreshBackupBtn" Content="刷新" Tag="&#xE72C;"
                                    Style="{StaticResource IconButton}" Click="RefreshBackup_Click"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== 剧情页 ===== -->
            <Grid x:Name="StoryPage" Visibility="Collapsed" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部工具栏：版本 / 存档槽 / 刷新 / 数据来源 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                        Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="剧情" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="2,0,18,0" />

                            <ComboBox x:Name="StoryVersionBox" Grid.Column="1" Width="220"
                                      Style="{StaticResource FlatCombo}"
                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                      Margin="0,0,10,0" SelectionChanged="StoryVersion_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox x:Name="StorySlotBox" Grid.Column="2" Width="230"
                                      Style="{StaticResource FlatCombo}"
                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                      Margin="0,0,10,0" SelectionChanged="StorySlot_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button x:Name="StoryRefreshBtn" Grid.Column="3" Content="刷新" Tag="&#xE72C;"
                                    Style="{StaticResource IconButton}" Click="StoryRefresh_Click" />
                        </Grid>

                        <Grid Margin="2,8,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="StoryStatusText" Grid.Column="0"
                                       Style="{StaticResource MutedText}" FontSize="11"
                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                       Text="选择一个存档作为起点，让游戏模拟后续剧情分支，结果只读展示。" />

                            <TextBlock x:Name="StorySourceText" Grid.Column="1" Style="{StaticResource MutedText}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                       VerticalAlignment="Top" Margin="12,0,0,0" Text="等待读取存档…" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 主体：左侧导图 + 右侧节点详情（已停用，保留控件供旧逻辑引用） -->
                <Grid x:Name="StoryPathPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="story.rightWidth"
                                           DefaultSize="380" MinPrevious="420" MinNext="280"
                                           Style="{StaticResource PaneSplitterStyle}" />

                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 筛选与视图操作 -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="StoryCatCharacter" Style="{StaticResource TextCheck}"
                                              Content="角色" IsChecked="True" Margin="2,0,16,0"
                                              Checked="StoryFilter_Changed" Unchecked="StoryFilter_Changed" />
                                    <CheckBox x:Name="StoryCatPlace" Style="{StaticResource TextCheck}"
                                              Content="地点" IsChecked="True" Margin="0,0,16,0"
                                              Checked="StoryFilter_Changed" Unchecked="StoryFilter_Changed" />
                                    <CheckBox x:Name="StoryCatEvent" Style="{StaticResource TextCheck}"
                                              Content="事件" IsChecked="True" Margin="0,0,16,0"
                                              Checked="StoryFilter_Changed" Unchecked="StoryFilter_Changed" />
                                    <CheckBox x:Name="StoryCatUnknown" Style="{StaticResource TextCheck}"
                                              Content="未分类" IsChecked="True" Margin="0,0,16,0"
                                              Checked="StoryFilter_Changed" Unchecked="StoryFilter_Changed" />
                                </WrapPanel>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="StorySearchBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                                             Height="30" Padding="8,4" FontSize="12"
                                             ToolTip="输入标题关键词后回车，定位到对应节点"
                                             TextChanged="StorySearch_TextChanged" KeyDown="StorySearch_KeyDown" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button x:Name="StoryFitBtn" Content="适应窗口" Tag="&#xE9A6;"
                                                Style="{StaticResource IconButton}" Click="StoryFit_Click"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="StoryResetBtn" Content="重置视图" Tag="&#xE777;"
                                                Style="{StaticResource IconButton}" Click="StoryReset_Click"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="StoryExpandBtn" Content="展开全部" Tag="&#xE8A5;"
                                                Style="{StaticResource IconButton}" Click="StoryExpand_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <controls:StoryMapView x:Name="StoryMap"
                                                           BackgroundBrush="{DynamicResource CardBrush}"
                                                           NodeBackground="{DynamicResource CardBrush}"
                                                           NodeBorderBrush="{DynamicResource BorderBrush}"
                                                           NodeTextBrush="{DynamicResource TextBrush}"
                                                           LinkBrush="{DynamicResource BorderBrush}"
                                                           AccentBrush="{DynamicResource AccentBrush}" />

                                    <TextBlock x:Name="StoryEmptyText" Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                               IsHitTestVisible="False"
                                               Text="先启动一次游戏完成数据落盘" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 节点详情 -->
                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="节点详情" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,2" />

                            <TextBlock x:Name="StoryDetailHint" Grid.Row="1" Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="在左侧导图中点击步骤节点查看详情。" />

                            <Grid x:Name="StoryDetailBody" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="150" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="StoryDetailTitle" Grid.Row="0" TextWrapping="Wrap"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />

                                <TextBlock x:Name="StoryDetailMeta" Grid.Row="1" TextWrapping="Wrap"
                                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

                                <StackPanel x:Name="StoryKeySection" Grid.Row="2" Margin="0,10,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock Text="关键字段" Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="StoryKeyFields">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <TextBlock Text="{Binding Key}" DockPanel.Dock="Left"
                                                                   Width="96" FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <DockPanel Grid.Row="3" Margin="0,12,0,4">
                                    <TextBlock x:Name="StoryVarCountText" DockPanel.Dock="Right"
                                               Style="{StaticResource MutedText}" FontSize="10" />
                                    <TextBlock Text="全部变量" Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DockPanel>

                                <ListBox x:Name="StoryVarList" Grid.Row="4" Background="Transparent"
                                         BorderThickness="0" Padding="0"
                                         HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{StaticResource ModItem}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Key}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Text="{Binding Value}" FontSize="11"
                                                           TextWrapping="Wrap" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <DockPanel Grid.Row="5" Margin="0,10,0,4">
                                    <Button x:Name="StoryCopyJsonBtn" DockPanel.Dock="Right" Content="复制 JSON"
                                            Style="{StaticResource TinyButton}" Width="Auto" Height="24"
                                            Padding="8,0" Click="StoryCopyJson_Click" />
                                    <TextBlock Text="原始 JSON" Style="{StaticResource MutedText}"
                                               FontWeight="SemiBold" />
                                </DockPanel>

                                <TextBox x:Name="StoryJsonBox" Grid.Row="6" Style="{StaticResource DarkTextBox}"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         FontFamily="Consolas" FontSize="11" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 模拟分支：默认视图，游戏内导出结果的只读树 -->
                <Grid x:Name="StoryBranchPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="story.branchRightWidth"
                                           DefaultSize="380" MinPrevious="420" MinNext="280"
                                           Style="{StaticResource PaneSplitterStyle}" />

                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="StoryBranchStatusText" Grid.Column="0"
                                           Style="{StaticResource MutedText}" FontSize="11"
                                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,12,0"
                                           Text="在游戏内使用「分支模拟」导出结果后，这里会显示可展开的模拟分支树。" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <CheckBox x:Name="StoryBranchSuccessOnly" Content="仅成功"
                                              Style="{StaticResource TextCheck}" VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Checked="StoryBranchFilter_Changed" Unchecked="StoryBranchFilter_Changed"
                                              ToolTip="只显示成功的分支节点，隐藏失败与界面类节点" />
                                    <Button x:Name="StoryBranchRefreshBtn" Content="刷新" Tag="&#xE72C;"
                                            Style="{StaticResource IconButton}" Click="StoryBranchRefresh_Click"
                                            Padding="10,4" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                                <TextBlock Text="起始存档：剧情页所选" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="2,0,14,6" />
                                <TextBlock Text="深度" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,4,6" />
                                <TextBox x:Name="StoryBranchDepthBox" Text="3" Width="40"
                                         Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" Padding="6,3" Height="26"
                                         FontSize="12" Margin="0,0,12,6" />
                                <TextBlock Text="预算" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,4,6" />
                                <TextBox x:Name="StoryBranchBudgetBox" Text="150" Width="56"
                                         Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" Padding="6,3" Height="26"
                                         FontSize="12" Margin="0,0,12,6" />
                                <TextBlock Text="种子" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,4,6" />
                                <TextBox x:Name="StoryBranchSeedBox" Width="96"
                                         Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" Padding="6,3" Height="26"
                                         FontSize="12" Margin="0,0,12,6"
                                         ToolTip="纯数字；留空则由游戏随机生成" />
                                <Button x:Name="StoryBranchRunBtn" Content="开始模拟" Tag="&#xE768;"
                                        Style="{StaticResource IconPrimaryButton}"
                                        Click="StoryBranchRun_Click" Padding="13,5" FontSize="12"
                                        IsEnabled="False" Margin="0,0,10,6" />
                                <Button x:Name="StoryBranchContinueBtn" Content="继续模拟" Tag="&#xE72A;"
                                        Style="{StaticResource IconButton}"
                                        Click="StoryBranchContinue_Click" Padding="11,5" FontSize="12"
                                        IsEnabled="False" Margin="0,0,10,6"
                                        ToolTip="从左侧选中的末端节点继续往下展开，会复用仍然开着的模拟页面" />
                                <Button x:Name="StoryBranchExportImageBtn" Content="导出图片" Tag="&#xE91B;"
                                        Style="{StaticResource IconButton}"
                                        Click="StoryBranchExportImage_Click" Padding="11,5" FontSize="12"
                                        IsEnabled="False" Margin="0,0,10,6"
                                        ToolTip="把整棵分支图（含节点与汇入箭头）导出为 PNG 图片" />
                                <Button x:Name="StoryBranchExportJsonBtn" Content="导出结果" Tag="&#xE896;"
                                        Style="{StaticResource IconButton}"
                                        Click="StoryBranchExportJson_Click" Padding="11,5" FontSize="12"
                                        IsEnabled="False" Margin="0,0,10,6"
                                        ToolTip="导出包含完整节点详情的 JSON 结果文件" />
                            </WrapPanel>

                            <TextBlock x:Name="StoryBranchRunStatus" Grid.Row="2"
                                       Style="{StaticResource MutedText}" FontSize="11"
                                       TextWrapping="Wrap" Margin="2,0,2,8"
                                       Text="尚未开始" />

                            <Border Grid.Row="3" Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" ClipToBounds="True">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  PanningMode="Both">
                                        <controls:StoryBranchGraphView x:Name="StoryBranchGraph"
                                                                      TextBrush="{DynamicResource TextBrush}"
                                                                      MutedBrush="{DynamicResource MutedBrush}"
                                                                      AccentBrush="{DynamicResource AccentBrush}" />
                                    </ScrollViewer>

                                    <TextBlock x:Name="StoryBranchEmptyText" Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                               IsHitTestVisible="False"
                                               Text="还没有模拟结果&#x0a;选择存档槽后点「开始模拟」，或在游戏内点「导出到启动器」" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="节点详情" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,6" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StoryBranchDetailPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 未检测到剧情分支模拟模组时的占位：引导安装 -->
                <Border x:Name="StoryModMissingPanel" Grid.Row="1" Visibility="Collapsed"
                        Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                        <TextBlock Text="请先安装「剧情分支模拟」模组"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,10,0,0"
                                   Text="剧情页依赖游戏内的 Story Branch Simulator（剧情分支模拟）模组。安装并在模组列表启用后，重新打开游戏页面即可开始模拟。" />
                        <StackPanel x:Name="StoryModActionPanel" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 诊断页 ===== -->
            <Grid x:Name="DiagnosticPage" Visibility="Collapsed" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 日志分析模式栏 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="日志分析" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="DiagModeBox" Style="{StaticResource FlatCombo}"
                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                  Width="130" Margin="14,0,0,0" VerticalAlignment="Center"
                                  ToolTip="手动诊断：分析指定的历史日志文件；实时诊断：统计当前游戏实例并自动给出诊断"
                                  SelectionChanged="DiagMode_Changed">
                            <ComboBoxItem Content="手动诊断" IsSelected="True" />
                            <ComboBoxItem Content="实时诊断" />
                        </ComboBox>
                        <ComboBox x:Name="DiagLogFileBox" Style="{StaticResource FlatCombo}"
                                  ItemContainerStyle="{StaticResource FlatComboItem}"
                                  Width="280" Margin="10,0,0,0" VerticalAlignment="Center"
                                  ToolTip="选择该版本 logs 目录下的日志文件，然后点左侧「分析」"
                                  DropDownOpened="DiagLogFile_DropDownOpened" />
                        <TextBlock x:Name="DiagLiveHint" Style="{StaticResource MutedText}" FontSize="10"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:PaneSplitter Grid.Column="1" Axis="Columns" SettingKey="diag.leftWidth"
                                       DefaultSize="340" MinPrevious="280" MinNext="420"
                                       Style="{StaticResource PaneSplitterStyle}" />

                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="诊断" FontSize="16" FontWeight="SemiBold" Margin="2,2,0,4" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,0,0,12"
                                       Text="检查依赖、版本与模组完整性；也可以分析游戏日志里的报错。" />

                            <TextBlock Text="目标版本" Style="{StaticResource MutedText}" Margin="2,0,0,6" />
                            <ComboBox x:Name="DiagTargetBox" Style="{StaticResource FlatCombo}"
                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                      Margin="0,0,0,12" SelectionChanged="DiagTarget_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ComboName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button x:Name="CompatCheckBtn" Content="兼容性检查" Tag="&#xE73E;"
                                    Style="{StaticResource IconButton}" Click="CompatCheck_Click" />
                            <Button x:Name="ExportDiagBtn" Content="导出诊断包" Tag="&#xE7B8;"
                                    Style="{StaticResource IconButton}" Click="ExportDiag_Click" Margin="0,8,0,0"
                                    ToolTip="把版本信息、依赖、模组清单与日志打包成 zip" />
                            <Button x:Name="ViewLauncherLogBtn" Content="打开启动器日志" Tag="&#xE7C3;"
                                    Style="{StaticResource IconButton}" Click="ViewLauncherLog_Click" Margin="0,8,0,0"
                                    ToolTip="用系统默认程序打开 logs\launcher.log" />
                            <Button x:Name="OpenGameLogBtn" Content="打开游戏日志" Tag="&#xE8A5;"
                                    Style="{StaticResource IconButton}" Click="OpenGameLog_Click" Margin="0,8,0,0"
                                    ToolTip="打开该版本目录 logs\game-yyyyMMdd-HHmmss.log（启动游戏后自动生成）" />
                            <Button x:Name="AnalyzeLogBtn" Content="分析" Tag="&#xE9D9;"
                                    Style="{StaticResource IconButton}" Click="AnalyzeLog_Click" Margin="0,8,0,0"
                                    ToolTip="手动诊断：分析已选日志文件；实时诊断：立即刷新当前游戏实例的统计与诊断" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

                            <TextBlock Text="存储维护" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />
                            <Button x:Name="ClearIdbCachesBtn" Content="清空 Mod 缓存（保留存档）" Tag="&#xE74D;"
                                    Style="{StaticResource IconButton}" Click="ClearIdbCaches_Click"
                                    ToolTip="删除该版本除存档库外的所有 IndexedDB（Mod 图片/翻译/包缓存与 Mod 设置），下次启动生效" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="2,8,0,0"
                                       Text="将清除 Mod 缓存与 Mod 本地设置，保留 saves/details 存档；下次启动自动执行并重新加载页面。建议先关闭正在运行的游戏页面。" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

                            <TextBlock Text="游戏日志" Style="{StaticResource SectionTitle}" Margin="2,0,0,10" />
                            <DockPanel>
                                <TextBlock Text="游戏日志保留份数" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="GameLogKeepBox" Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          Width="76" Margin="10,0,0,0"
                                          SelectionChanged="GameLogKeep_Changed">
                                    <ComboBoxItem Content="5" />
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" IsSelected="True" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="单份上限" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="GameLogMaxBox" Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          Width="96" Margin="10,0,0,0"
                                          SelectionChanged="GameLogMax_Changed">
                                    <ComboBoxItem Content="无限制" />
                                    <ComboBoxItem Content="10 MB" />
                                    <ComboBoxItem Content="30 MB" IsSelected="True" />
                                    <ComboBoxItem Content="100 MB" />
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="超限后" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="GameLogOverflowBox" Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          Width="140" Margin="10,0,0,0"
                                          SelectionChanged="GameLogOverflow_Changed">
                                    <ComboBoxItem Content="写新文件（-2、-3…）" IsSelected="True" />
                                    <ComboBoxItem Content="停止写入" />
                                </ComboBox>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="日志详细度" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="LogVerbosityBox" Style="{StaticResource FlatCombo}"
                                          ItemContainerStyle="{StaticResource FlatComboItem}"
                                          Width="150" Margin="10,0,0,0"
                                          ToolTip="标准：错误只记录消息；详细：错误额外记录完整堆栈、内部异常与调用位置（日志体积更大）"
                                          SelectionChanged="LogVerbosity_Changed">
                                    <ComboBoxItem Content="标准" IsSelected="True" />
                                    <ComboBoxItem Content="详细（含堆栈）" />
                                </ComboBox>
                            </DockPanel>

                            <TextBlock Text="上报队列上限" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="LogQueueSlider" Width="180" Minimum="1" Maximum="64"
                                        VerticalAlignment="Center"
                                        ValueChanged="LogUpload_Changed"
                                        LostMouseCapture="LogUpload_LostMouseCapture" />
                                <TextBlock x:Name="LogQueueText" Style="{StaticResource MutedText}"
                                           Width="56" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="上报合并间隔" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="LogFlushSlider" Width="180" Minimum="200" Maximum="5000"
                                        TickFrequency="100" VerticalAlignment="Center"
                                        ValueChanged="LogUpload_Changed"
                                        LostMouseCapture="LogUpload_LostMouseCapture" />
                                <TextBlock x:Name="LogFlushText" Style="{StaticResource MutedText}"
                                           Width="56" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock x:Name="GameLogStatusText" Style="{StaticResource MutedText}" FontSize="10"
                                       TextWrapping="Wrap" Margin="2,12,2,0"
                                       Text="最近一次日志：本次运行还没有收到游戏页面上报（启动游戏后自动采集）。" />

                            <TextBlock Style="{StaticResource MutedText}" FontSize="10"
                                       TextWrapping="Wrap" Margin="2,8,2,0"
                                       Text="诊断结果只在本页显示，不会改动游戏文件；日志设置对所有版本生效。" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="诊断输出" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="选择左侧操作查看结果；内容可选中复制。" />
                        </DockPanel>

                        <TextBox x:Name="DiagBox" Grid.Row="1" Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 Foreground="{DynamicResource MutedBrush}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsUndoEnabled="False" TextOptions.TextFormattingMode="Display"
                                 Text="点「兼容性检查」查看依赖与版本结果；手动诊断选择日志文件后点「分析」，实时诊断会自动统计当前游戏实例。" />
                    </Grid>
                </Border>
                </Grid>
            </Grid>

            <!-- ===== 设置页 ===== -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="14">
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部面包屑 + 分类说明 -->
                        <Border Grid.Row="0" Padding="18,15,18,13"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <WrapPanel x:Name="SettingsCrumbPanel" VerticalAlignment="Center" />
                                <TextBlock x:Name="SettingsDescText" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Text="选择一个分类查看相关设置。" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18,14,18,18">
                            <Grid>
                                <!-- 首页：分类卡片铺满 -->
                                <StackPanel x:Name="SettingsRootPanel">
                                    <Button Style="{StaticResource SettingsCard}" Tag="网络下载"
                                            Click="SettingsCategory_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource AccentPaleBrush}">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="网络下载" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Text="模组下载源、GitHub 接口源：选择下载安装包和访问接口时走的线路。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource SettingsCard}" Tag="数据与索引"
                                            Click="SettingsCategory_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource AccentPaleBrush}">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="数据与索引" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Text="模组市场索引源、启动时预取索引、是否把补全的作者信息写回模组包。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource SettingsCard}" Tag="问题检查"
                                            Click="SettingsCategory_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource AccentPaleBrush}">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="问题检查" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Text="游戏版本差异告警阈值：决定「可能存在问题」里版本不匹配的敏感度。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource SettingsCard}" Tag="游戏浏览器"
                                            Click="SettingsCategory_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource AccentPaleBrush}">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="游戏浏览器" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Text="打开游戏页使用的浏览器：独立 Profile 支持关页自动停服，也可改为系统默认浏览器。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource SettingsCard}" Tag="界面与外观"
                                            Click="SettingsCategory_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource AccentPaleBrush}">
                                                <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="界面与外观" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Text="深色 / 亮色 / 跟随系统主题、主题色、玩家头像、UI 美化包与界面过渡动画。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource SettingsCard}" Tag="版本信息"
                                            Click="SettingsCategory_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" CornerRadius="9"
                                                    Background="{DynamicResource AccentPaleBrush}">
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="版本信息" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Text="启动器版本号、提交与构建时间，以及检查更新。" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- 网络下载 -->
                                <StackPanel x:Name="SettingsNetworkPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="模组下载源" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="只影响 Release 资产包的下载地址（游戏本体与模组都走这里）；选用某个镜像失败时会自动回退到 GitHub 直连。" />
                                            <ComboBox x:Name="DownloadSourceBox" Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      Width="236" HorizontalAlignment="Left"
                                                      SelectionChanged="DownloadSource_Changed">
                                                <ComboBoxItem Content="自动（测速选最快）" Tag="auto" />
                                                <ComboBoxItem Content="GH-Proxy 镜像" Tag="ghproxy" />
                                                <ComboBoxItem Content="GH-Proxy.com 镜像" Tag="ghproxycom" />
                                                <ComboBoxItem Content="LLKK 镜像" Tag="llkk" />
                                                <ComboBoxItem Content="FastGit 镜像" Tag="fastgit" />
                                                <ComboBoxItem Content="DDLC 镜像" Tag="ddlc" />
                                                <ComboBoxItem Content="Boki 镜像" Tag="boki" />
                                                <ComboBoxItem Content="GHProxy.net 镜像" Tag="ghproxynet" />
                                                <ComboBoxItem Content="ModHub 加速" Tag="worker" />
                                                <ComboBoxItem Content="GitHub 直连" Tag="github" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="GitHub 接口源" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="版本列表、模组版本、README 等都走 GitHub API（api.github.com）。直连被 403/429 限流时切到 GH-Proxy 镜像，它会带令牌转发。" />
                                            <ComboBox x:Name="ApiSourceBox" Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      Width="236" HorizontalAlignment="Left"
                                                      SelectionChanged="ApiSource_Changed">
                                                <ComboBoxItem Content="自动（直连失败走 GH-Proxy）" Tag="auto" />
                                                <ComboBoxItem Content="GitHub 直连" Tag="github" />
                                                <ComboBoxItem Content="GH-Proxy 镜像" Tag="ghproxy" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 数据与索引 -->
                                <StackPanel x:Name="SettingsDataPanel" Visibility="Collapsed">
                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="模组市场索引源" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="只影响模组市场索引的拉取地址，与模组包下载无关。改完后点「刷新列表」或重新打开启动器生效。" />
                                            <ComboBox x:Name="MarketSourceBox" Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      Width="236" HorizontalAlignment="Left"
                                                      SelectionChanged="MarketSource_Changed">
                                                <ComboBoxItem Content="自动（主源失败时用备用）" Tag="auto" />
                                                <ComboBoxItem Content="主源 dol.alseece.top" Tag="primary" />
                                                <ComboBoxItem Content="备用源 workers.dev" Tag="backup" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SettingsItemCard}">
                                        <StackPanel>
                                            <TextBlock Text="启动时预取索引" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                                       Margin="0,4,0,9"
                                                       Text="游戏本体、模组市场与整合包索引在启动时按所选时机于后台拉取，不阻塞界面；选「启动时不预取」后进下载中心再加载。" />
                                            <ComboBox x:Name="PrefetchBox" Style="{StaticResource FlatCombo}"
                                                      ItemContainerStyle="{StaticResource FlatComboItem}"
                                                      Width="236" HorizontalAlignment="Left"
                                                      SelectionChanged="Prefetch_Changed">
                                                <ComboBoxItem Content="同时拉取（推荐）" Tag="parallel" />
                                                <ComboBoxItem Content="启动时不预取" Tag="none" />
                                                <ComboBoxItem Content="自定义顺序" Tag="custom" />
                                            </ComboBox>

                                            <Border x:Name="PrefetchOrderPanel" Visibility="Collapsed"
                                                    Margin="0,10,0,0" Padding="10" MinWidth="260"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource CardBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="按从上到下的顺序依次拉取" Style="{StaticResource MutedText}"
                                                               Margin="0,0,0,6" />
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
