<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DoLLauncher.App</AssemblyName>
    <RootNamespace>DoLLauncher</RootNamespace>
    <!-- 首期页面用反射绑定，等 ViewModel 稳定后再开编译绑定 -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\DoLLauncher\Assets\dol-favicon.png" Link="Assets\dol-favicon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoLLauncher.Core\DoLLauncher.Core.csproj" />
  </ItemGroup>

</Project>
