<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DoLLauncher.Views.BackupPage">

  <Grid ColumnDefinitions="340,14,*">

    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="备份" FontSize="16" FontWeight="SemiBold" Margin="2,2,0,12" />

          <TextBlock Text="目标版本" Classes="muted" Margin="2,0,0,6" />
          <ComboBox ItemsSource="{Binding Targets}"
                    SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                    Margin="0,0,0,12">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Content="打开存档助手" Tag="&#xE74E;" Theme="{StaticResource IconButton}"
                  Command="{Binding OpenSavesHelperCommand}"
                  ToolTip.Tip="多槽批量导入/导出、单槽管理与启动器里的存档备份" />
          <Button Content="立即备份存档" Tag="&#xE896;" Theme="{StaticResource IconButton}"
                  Command="{Binding BackupSavesNowCommand}" Margin="0,8,0,0"
                  ToolTip.Tip="直接用页面写回的磁盘镜像备份，不打开浏览器窗口" />

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

          <Button Content="导出模组配置" Tag="&#xE8B7;" Theme="{StaticResource IconButton}"
                  Command="{Binding ExportModsConfigCommand}" />
          <Button Content="还原模组配置" Tag="&#xE8E5;" Theme="{StaticResource IconButton}"
                  Command="{Binding RestoreModsConfigCommand}" Margin="0,8,0,0" />
          <Button Content="创建整版快照" Tag="&#xE7B8;" Theme="{StaticResource IconButton}"
                  Command="{Binding CreateSnapshotCommand}" Margin="0,8,0,0" />
          <CheckBox Content="快照包含游戏本体（体积大，还原时可当新版本导入）" Margin="4,8,0,0"
                    IsChecked="{Binding SnapshotIncludeGame, Mode=TwoWay}" />

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14" />

          <CheckBox Content="启动时自动备份模组与配置"
                    IsChecked="{Binding AutoBackup, Mode=TwoWay}" />
          <CheckBox Content="启动时自动备份浏览器存档（会短暂打开备份页）" Margin="0,10,0,0"
                    IsChecked="{Binding AutoSave, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
            <TextBlock Text="快照/自动备份保留份数" Classes="muted" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding KeepOptions}"
                      SelectedItem="{Binding Keep, Mode=TwoWay}"
                      Width="72" Margin="10,0,0,0" />
          </StackPanel>
          <TextBlock Text="{Binding MirrorText}" Classes="muted" FontSize="10"
                     TextWrapping="Wrap" Margin="2,8,2,0" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="10"
                   TextWrapping="Wrap" Margin="2,12,2,0"
                   Text="备份都放在启动器根目录的 backups\版本名 下，不会污染游戏目录。存档镜像由游戏页自动写回磁盘，备份/还原都不需要打开浏览器。" />
        <Border Background="Transparent" />
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="Transparent" />

    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
      <Grid RowDefinitions="Auto,*,Auto">

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="{Binding CountText}" DockPanel.Dock="Right"
                     Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="备份列表" Classes="section" />
          <TextBlock Classes="muted" FontSize="11" Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Text="双击快照可直接导入；模组配置会按文件里的顺序还原。" />
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Backups}"
                 SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerTheme="{StaticResource ModItem}"
                 DoubleTapped="OnBackupDoubleTapped"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right"
                             Classes="muted" FontSize="11"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="13"
                             Foreground="{DynamicResource TextBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Border Background="{DynamicResource AccentPaleBrush}" CornerRadius="5"
                          Padding="6,1" Margin="0,0,0,0" VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding FileName}" FontSize="10"
                               Foreground="{DynamicResource AccentBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                  </Border>
                </DockPanel>
                <TextBlock Text="{Binding TimeText}" Classes="muted"
                           FontSize="11" Margin="0,4,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
          <Button Content="还原所选备份" Tag="&#xE777;" Theme="{StaticResource IconPrimaryButton}"
                  Command="{Binding RestoreSelectedCommand}" Margin="0,0,8,8" />
          <Button Content="删除" Tag="&#xE74D;" Theme="{StaticResource IconButton}"
                  Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,8" />
          <Button Content="打开备份目录" Tag="&#xE8B7;" Theme="{StaticResource IconButton}"
                  Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
          <Button Content="刷新" Tag="&#xE72C;" Theme="{StaticResource IconButton}"
                  Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
