<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DoLLauncher.Views.DownloadPage">

  <Grid ColumnDefinitions="212,14,*">

    <!-- 左侧：分类与下载任务 -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="下载中心" FontSize="16" FontWeight="SemiBold" Margin="6,2,0,10" />

          <RadioButton Theme="{StaticResource NavItem}" GroupName="DlNav"
                       Tag="&#xE774;" Content="游戏本体"
                       IsChecked="{Binding IsGameTab, Mode=OneWay}"
                       Command="{Binding SwitchTabCommand}" CommandParameter="game" />
          <RadioButton Theme="{StaticResource NavItem}" GroupName="DlNav"
                       Tag="&#xE7B8;" Content="模组市场"
                       IsChecked="{Binding IsModTab, Mode=OneWay}"
                       Command="{Binding SwitchTabCommand}" CommandParameter="mod" />

          <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,12" />

          <StackPanel IsVisible="{Binding IsModTab}">
            <TextBlock Text="安装到版本" Classes="muted" Margin="8,0,0,6" />
            <ComboBox ItemsSource="{Binding Targets}"
                      SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" Margin="4,0,4,0">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Button Content="刷新列表" Tag="&#xE72C;" Theme="{StaticResource IconButton}"
                  Margin="4,10,4,0" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="10"
                   TextWrapping="Wrap" Margin="6,12,6,0"
                   Text="本体可选汉化整包或 ModLoader Neo 单文件，均来自 GitHub Release；模组索引来自 ModHub 市场。安装后会自动重建 modList.json。" />

        <Grid Margin="0,14,0,0" RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="下载列表" FontSize="13" FontWeight="SemiBold"
                     Margin="6,0,0,6" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}"
                   SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   ItemContainerTheme="{StaticResource ModItem}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <ProgressBar Theme="{StaticResource ThinProgress}" Maximum="1"
                               Value="{Binding Progress, Mode=OneWay}" Margin="0,5,0,4" />
                  <TextBlock Text="{Binding InfoText}" Classes="muted" FontSize="10"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="1" Text="当前还没有正在进行的下载任务"
                     Classes="muted" FontSize="10"
                     VerticalAlignment="Top" HorizontalAlignment="Left"
                     Margin="6,2,0,0" TextWrapping="Wrap"
                     IsVisible="{Binding HasNoTasks}" />

          <Button Grid.Row="2" Content="取消下载" Tag="&#xE711;" Theme="{StaticResource IconButton}"
                  Margin="4,10,4,0" Command="{Binding CancelTaskCommand}"
                  IsVisible="{Binding HasTasks}" />
        </Grid>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="Transparent" />

    <!-- 右侧：内容与运行记录 -->
    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
      <Grid RowDefinitions="*,10,150">

        <Grid Grid.Row="0">

          <!-- 游戏本体 -->
          <Grid IsVisible="{Binding IsGameTab}" RowDefinitions="Auto,Auto,*,Auto,Auto">
            <StackPanel Grid.Row="0">
              <TextBlock Text="游戏本体下载" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding GameHint}" Classes="muted" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,14,0,10">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="游戏源" Classes="muted" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding GameSources}"
                          SelectedItem="{Binding SelectedGameSource, Mode=TwoWay}"
                          Width="260">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <WrapPanel Margin="0,10,0,0">
                <CheckBox Content="使用 polyfill 版本" Margin="0,0,20,0"
                          IsChecked="{Binding UsePolyfill, Mode=TwoWay}"
                          IsEnabled="{Binding IsZipSource}" />
                <CheckBox Content="同时安装 ModI18N 汉化模组" Margin="0,0,20,0"
                          IsChecked="{Binding InstallI18n, Mode=TwoWay}" />
                <CheckBox Content="同时安装原版图片包"
                          IsChecked="{Binding InstallImagePack, Mode=TwoWay}" />
              </WrapPanel>
            </StackPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding GameReleases}"
                     SelectedItem="{Binding SelectedGameRelease, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerTheme="{StaticResource ModItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding BadgeText}" DockPanel.Dock="Right"
                                 FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                 Foreground="{DynamicResource TextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Summary}" Classes="muted" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding AssetSummary}" Classes="muted" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="下载并安装" Tag="&#xE896;" Theme="{StaticResource IconPrimaryButton}"
                      Command="{Binding DownloadGameCommand}" />
              <TextBlock Text="{Binding GameStatus}" Classes="muted" Margin="12,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>

            <ProgressBar Grid.Row="4" Theme="{StaticResource ThinProgress}"
                         Margin="0,8,0,0" Maximum="1"
                         Value="{Binding GameProgress}"
                         IsVisible="{Binding IsGameProgressVisible}" />
          </Grid>

          <!-- 模组市场 -->
          <Grid IsVisible="{Binding IsModTab}" RowDefinitions="Auto,Auto,*,Auto,Auto">
            <StackPanel Grid.Row="0">
              <TextBlock Text="模组市场" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MarketHint}" Classes="muted" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,14,0,10">
              <DockPanel>
                <TextBox DockPanel.Dock="Left" Width="260"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="搜索模组名 / 作者 / 标签 / 简介" />
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          Width="150" Margin="10,0,0,0" />
                <ComboBox ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          Width="132" Margin="10,0,0,0">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding MarketCountText}" Classes="muted"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
              </DockPanel>

              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="匹配" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding MatchOptions}"
                          SelectedItem="{Binding SelectedMatch, Mode=TwoWay}" Width="150">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="范围" Classes="muted" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox ItemsSource="{Binding ScopeOptions}"
                          SelectedItem="{Binding SelectedScope, Mode=TwoWay}" Width="96">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="排序" Classes="muted" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}" Width="126">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="倒序" Margin="10,0,0,0"
                          IsChecked="{Binding SortDescending, Mode=TwoWay}" />
              </DockPanel>
            </StackPanel>

            <ListBox Grid.Row="2" ItemsSource="{Binding MarketView}"
                     SelectedItem="{Binding SelectedMarketMod, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerTheme="{StaticResource ModItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding Subtitle}" DockPanel.Dock="Right"
                                 Classes="muted" FontSize="11"
                                 VerticalAlignment="Center" Margin="8,0,0,0" />
                      <Border DockPanel.Dock="Right" Background="{DynamicResource AccentPaleBrush}"
                              CornerRadius="5" Padding="7,2" Margin="8,0,0,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                 Foreground="{DynamicResource TextBrush}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Row="3" Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto">
              <StackPanel Orientation="Horizontal">
                <Button Content="下载并安装" Tag="&#xE896;" Theme="{StaticResource IconPrimaryButton}"
                        Command="{Binding DownloadModCommand}" />
                <ComboBox ItemsSource="{Binding ModReleases}"
                          SelectedItem="{Binding SelectedModRelease, Mode=TwoWay}"
                          Width="150" Margin="10,0,0,0"
                          ToolTip.Tip="选择要安装的历史 Release">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding HasEditions}">
                  <TextBlock Text="包型" Classes="muted" VerticalAlignment="Center" Margin="10,0,6,0" />
                  <ComboBox ItemsSource="{Binding Editions}"
                            SelectedItem="{Binding SelectedEdition, Mode=TwoWay}"
                            Width="170"
                            ToolTip.Tip="同一个模组的不同包型 / 包体系列">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <ComboBox ItemsSource="{Binding AssetOptions}"
                          SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                          Width="110" Margin="10,0,0,0"
                          ToolTip.Tip="这个包型下的具体版本，默认选最新">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="加载版本" Tag="&#xE72C;" Theme="{StaticResource IconButton}"
                        Margin="8,0,0,0" Command="{Binding LoadModVersionsCommand}" />
                <TextBlock Text="{Binding MarketStatus}" Classes="muted"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </ScrollViewer>

            <ProgressBar Grid.Row="4" Theme="{StaticResource ThinProgress}"
                         Margin="0,8,0,0" Maximum="1"
                         Value="{Binding MarketProgress}"
                         IsVisible="{Binding IsMarketProgressVisible}" />
          </Grid>
        </Grid>

        <Border Grid.Row="1" Background="Transparent" />

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="运行记录" Classes="section" Margin="0,0,0,6" />
          <TextBox Grid.Row="1" Text="{Binding LogText}"
                   IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                   Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="NoWrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
