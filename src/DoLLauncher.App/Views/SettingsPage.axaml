<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="using:Avalonia.Media"
             x:Class="DoLLauncher.Views.SettingsPage">

  <Border Background="{DynamicResource PanelBrush}" CornerRadius="12">
    <Grid RowDefinitions="Auto,*">

      <!-- 顶部面包屑 + 分类说明 -->
      <Border Grid.Row="0" Padding="18,15,18,13"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="设置" Theme="{StaticResource LinkButton}"
                    FontSize="17" Command="{Binding HomeCommand}"
                    IsVisible="{Binding !IsHome}" />
            <TextBlock Text="›" FontSize="15" Margin="4,0"
                       Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !IsHome}" />
            <TextBlock Text="{Binding CurrentTitle}" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" Padding="18,14,18,18"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid>

          <!-- 首页 -->
          <StackPanel IsVisible="{Binding IsHome}">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Theme="{StaticResource SettingsCard}" Command="{Binding OpenCommand}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="38" Height="38" CornerRadius="9"
                              Background="{DynamicResource AccentPaleBrush}">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="&#xE76C;"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- 网络下载 -->
          <StackPanel IsVisible="{Binding IsNetwork}">
            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="模组下载源" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="只影响 Release 资产包的下载地址（游戏本体与模组都走这里）；选用某个镜像失败时会自动回退到 GitHub 直连。" />
                <ComboBox ItemsSource="{Binding DownloadSourceOptions}"
                          SelectedItem="{Binding SelectedDownloadSource, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="GitHub 接口源" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="版本列表、模组版本、README 等都走 GitHub API（api.github.com）。直连被 403/429 限流时切到 GH-Proxy 镜像，它会带令牌转发。" />
                <ComboBox ItemsSource="{Binding ApiSourceOptions}"
                          SelectedItem="{Binding SelectedApiSource, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 数据与索引 -->
          <StackPanel IsVisible="{Binding IsData}">
            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="模组市场索引源" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="只影响模组市场索引的拉取地址，与模组包下载无关。改完后点「刷新列表」或重新打开启动器生效。" />
                <ComboBox ItemsSource="{Binding MarketSourceOptions}"
                          SelectedItem="{Binding SelectedMarketSource, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="启动时预取索引" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="游戏本体与模组市场索引都在启动时于后台异步拉取，不阻塞界面；关掉后进下载中心再加载。" />
                <ComboBox ItemsSource="{Binding PrefetchOptions}"
                          SelectedItem="{Binding SelectedPrefetch, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Button Theme="{StaticResource SettingsCard}" Command="{Binding OpenModInfoCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="38" Height="38" CornerRadius="9"
                        Background="{DynamicResource AccentPaleBrush}">
                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="17" Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="模组信息" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="是否把补全的作者 / 主页写回模组包。" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="&#xE76C;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>

          <!-- 数据与索引 → 模组信息 -->
          <StackPanel IsVisible="{Binding IsModInfo}">
            <Border Classes="itemcard">
              <StackPanel>
                <CheckBox Content="把补全的作者 / 主页写回模组包"
                          IsChecked="{Binding WriteModMetadata, Mode=TwoWay}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="只在模组 boot.json 缺少对应字段时补写；已有的 author / homepage 不会被覆盖。关闭后信息只在详情窗里显示，不改动模组文件。" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 问题检查 -->
          <StackPanel IsVisible="{Binding IsProblem}">
            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="版本差异告警阈值" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="比较模组声明的目标游戏版本与当前版本的第三段（z）：等于所选值显示橙色提醒，超过则显示红色警告。缺少前置、模组重复与模组冲突始终按红色处理。" />
                <ComboBox ItemsSource="{Binding VersionGapOptions}"
                          SelectedItem="{Binding SelectedVersionGap, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 游戏浏览器 -->
          <StackPanel IsVisible="{Binding IsBrowser}">
            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="承载方式" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="独立 Profile：用本机 Edge / Chrome 打开独立窗口，只使用启动器自己的 profile（各版本共用，按端口隔离数据），支持静默清缓存、关页检测与数据落盘；系统默认浏览器不具备这些能力。修改后下次启动游戏生效。" />
                <ComboBox ItemsSource="{Binding BrowserModeOptions}"
                          SelectedItem="{Binding SelectedBrowserMode, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="关闭游戏页面时" FontWeight="SemiBold" Margin="0,14,0,6" />
                <ComboBox ItemsSource="{Binding ClosePageOptions}"
                          SelectedItem="{Binding SelectedClosePage, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="仅在支持关页检测的承载方式（独立 Profile / 自定义 + 独立 Profile）下生效。" />
                <TextBlock Text="{Binding BrowserStatus}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel IsEnabled="{Binding IsCustomBrowser}">
                <TextBlock Text="自定义浏览器" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="仅在承载方式为「自定义浏览器」时生效。参数中可用 {url} 作为页面地址占位；不写占位时会自动把地址追加到参数末尾。" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding BrowserExecutable, Mode=TwoWay}"
                           LostFocus="OnBrowserExeLostFocus" />
                  <Button Grid.Column="1" Content="浏览…" Theme="{StaticResource FlatButton}"
                          Padding="14,4,14,4" Margin="8,0,0,0"
                          Click="OnBrowseBrowserExeClick" />
                </Grid>
                <TextBlock Text="启动参数" Classes="muted" Margin="0,10,0,6" />
                <TextBox Text="{Binding BrowserArguments, Mode=TwoWay}"
                         LostFocus="OnBrowserArgsLostFocus" />
                <CheckBox Content="使用独立 Profile" Margin="0,12,0,0"
                          IsChecked="{Binding BrowserUseProfile, Mode=TwoWay}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="勾选后使用启动器专用的浏览器 profile 目录（所有版本共用，不复制你日常浏览器的数据），可同时启用静默清缓存与关页检测；不勾选时窗口关闭通常无法可靠检测。" />
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="关页检测时间参数" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="心跳由页面脚本定时上报。时间越大越不容易把加载中的游戏误判为关闭，但真正关页后停服也会更慢。修改下次打开页面生效。" />
                <TextBlock Text="页面心跳间隔" Classes="muted" />
                <StackPanel Orientation="Horizontal">
                  <Slider Width="200" Minimum="1" Maximum="30"
                          Value="{Binding HeartbeatSeconds, Mode=TwoWay}"
                          PointerCaptureLost="OnTimingSliderCommit" />
                  <TextBlock Text="{Binding HeartbeatText}" Classes="muted"
                             Width="56" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="心跳超时判定" Classes="muted" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal">
                  <Slider Width="200" Minimum="5" Maximum="180"
                          Value="{Binding HeartbeatTimeoutSeconds, Mode=TwoWay}"
                          PointerCaptureLost="OnTimingSliderCommit" />
                  <TextBlock Text="{Binding HeartbeatTimeoutText}" Classes="muted"
                             Width="56" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="首次心跳宽限" Classes="muted" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal">
                  <Slider Width="200" Minimum="5" Maximum="600"
                          Value="{Binding FirstGraceSeconds, Mode=TwoWay}"
                          PointerCaptureLost="OnTimingSliderCommit" />
                  <TextBlock Text="{Binding FirstGraceText}" Classes="muted"
                             Width="56" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="关闭防抖" Classes="muted" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal">
                  <Slider Width="200" Minimum="0" Maximum="60"
                          Value="{Binding CloseDebounceSeconds, Mode=TwoWay}"
                          PointerCaptureLost="OnTimingSliderCommit" />
                  <TextBlock Text="{Binding CloseDebounceText}" Classes="muted"
                             Width="56" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="能力差异" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="独立 Profile：支持静默清缓存、数据落盘，关闭页面后按设置停止本地服务器。&#10;系统默认浏览器：不支持静默清缓存与数据落盘，关页检测靠页面心跳仍然有效。&#10;自定义浏览器：启用独立 Profile 时支持静默清缓存与数据落盘。" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 界面与外观 -->
          <StackPanel IsVisible="{Binding IsAppearance}">
            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="玩家头像" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="只保存在启动器目录的 user 文件夹里，不会改动游戏文件；支持 PNG / JPG / BMP / GIF，最大 8 MB。" />
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12,0,0">
                  <Panel Width="64" Height="64">
                    <Ellipse Fill="{DynamicResource AccentPaleBrush}" />
                    <Ellipse>
                      <Ellipse.Fill>
                        <ImageBrush Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                      </Ellipse.Fill>
                    </Ellipse>
                  </Panel>
                  <StackPanel Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="上传头像" Theme="{StaticResource FlatButton}"
                              Padding="12,5,12,5" Command="{Binding UploadAvatarCommand}" />
                      <Button Content="恢复默认" Theme="{StaticResource FlatButton}"
                              Padding="12,5,12,5" Command="{Binding ResetAvatarCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AvatarStatusText}" Classes="muted"
                               TextWrapping="Wrap" MaxWidth="440" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <CheckBox Content="启用界面过渡动画" IsChecked="{Binding ShowAnimations, Mode=TwoWay}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="页面切换与控件悬停时的短促过渡；关闭后界面立即切换，适合远程桌面或低性能设备。" />
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="主题" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="切换整个界面的配色；跟随系统时随系统的亮色 / 深色设置自动变化。" />
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Width="236" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="主题色" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="自定义强调色（按钮、选中态、分页头等）。用色相 / 饱和度 / 亮度滑块微调；饱和度 100% 为程序推荐的鲜艳度，0% 为灰色。" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Width="56" Height="30" CornerRadius="6"
                          Background="{Binding AccentPreviewBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                  <TextBlock Text="{Binding AccentPreviewHex}" Classes="muted" VerticalAlignment="Center" />
                  <Button Content="恢复默认" Theme="{StaticResource FlatButton}"
                          Padding="12,4,12,4" Command="{Binding AccentResetCommand}" />
                </StackPanel>
                <TextBlock Text="色相" Classes="muted" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                  <Slider x:Name="AccentHueSlider" Width="220" Minimum="0" Maximum="360"
                          Value="{Binding AccentHue, Mode=TwoWay}"
                          PointerCaptureLost="OnAccentSliderCommit" />
                  <TextBlock Text="{Binding AccentHueText}" Classes="muted"
                             Width="44" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="饱和度" Classes="muted" Margin="0,10,0,4" />
                <StackPanel Orientation="Horizontal">
                  <Slider x:Name="AccentSaturationSlider" Width="220" Minimum="0" Maximum="100"
                          Value="{Binding AccentSaturation, Mode=TwoWay}"
                          PointerCaptureLost="OnAccentSliderCommit" />
                  <TextBlock Text="{Binding AccentSaturationText}" Classes="muted"
                             Width="44" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="亮度" Classes="muted" Margin="0,10,0,4" />
                <StackPanel Orientation="Horizontal">
                  <Slider x:Name="AccentLightnessSlider" Width="220" Minimum="0" Maximum="100"
                          Value="{Binding AccentLightness, Mode=TwoWay}"
                          PointerCaptureLost="OnAccentSliderCommit" />
                  <TextBlock Text="{Binding AccentLightnessText}" Classes="muted"
                             Width="44" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="启动器副标题" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="显示在左上角「DoL 启动器」下方的一行小字；留空时使用「版本 · 模组 · 存档」。" />
                <TextBox Text="{Binding Subtitle, Mode=TwoWay}" MaxLength="32"
                         Width="236" HorizontalAlignment="Left"
                         LostFocus="OnSubtitleLostFocus" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 版本信息 -->
          <StackPanel IsVisible="{Binding IsVersion}">
            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="启动器版本" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VersionInfoText}" Classes="muted"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <CheckBox Content="启动时自动检测更新"
                          IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="启动器启动后在后台检查 GitHub 最新 Release，有更新时提示；网络异常时不弹窗，只写入日志。" />
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <DockPanel>
                  <Button Content="项目主页" Tag="&#xE774;" Theme="{StaticResource IconButton}"
                          DockPanel.Dock="Right" HorizontalAlignment="Right"
                          Command="{Binding ProjectHomeCommand}" />
                  <TextBlock Text="致谢名单" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding CreditItems}" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,6">
                        <Button Content="主页" Theme="{StaticResource LinkButton}"
                                DockPanel.Dock="Right" IsVisible="{Binding HasLink}"
                                Command="{Binding OpenCommand}" />
                        <TextBlock Text="{Binding Title}" Classes="muted" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="反馈与建议" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="遇到问题或有建议时，可跳转到 GitHub Issue 模板选择页；提交前建议附上诊断页导出的诊断包。" />
                <Button Content="打开反馈页" Tag="&#xE774;" Theme="{StaticResource IconButton}"
                        HorizontalAlignment="Left" Command="{Binding FeedbackCommand}" />
              </StackPanel>
            </Border>

            <Border Classes="itemcard">
              <StackPanel>
                <TextBlock Text="检查更新" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,4,0,9"
                           Text="从 GitHub Release 获取最新版本并与当前版本比较；发现新版本时可展示更新日志并直接下载替换启动器本体。" />
                <Button Content="检查更新" Tag="&#xE895;" Theme="{StaticResource IconButton}"
                        HorizontalAlignment="Left" Command="{Binding CheckUpdateCommand}" />
                <TextBlock Text="{Binding UpdateStatus}" Classes="muted"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
