<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DoLLauncher.Views"
        x:Class="DoLLauncher.Views.MainWindow"
        Title="DoL 版本启动器"
        Icon="avares://DoLLauncher.App/Assets/dol-favicon.png"
        Width="1180" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        RenderOptions.TextRenderingMode="SubpixelAntialias"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Noto Sans CJK SC, Segoe UI"
        FontSize="13">

  <Grid ColumnDefinitions="184,6,*">

    <!-- 左侧 PCL 式导航 -->
    <Border Grid.Column="0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="6,0,0,16">
            <Panel Width="34" Height="34">
              <Ellipse Fill="{DynamicResource AccentPaleBrush}" />
              <Ellipse>
                <Ellipse.Fill>
                  <ImageBrush Source="{Binding Settings.AvatarImage}" Stretch="UniformToFill" />
                </Ellipse.Fill>
              </Ellipse>
            </Panel>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="DoL 启动器" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="{Binding Settings.SubtitleText}" FontSize="10" />
            </StackPanel>
          </StackPanel>

          <RadioButton Theme="{StaticResource NavItem}" GroupName="MainNav"
                       Tag="&#xE81E;" Content="版本管理" IsChecked="True"
                       Command="{Binding NavigateCommand}" CommandParameter="versions" />
          <RadioButton Theme="{StaticResource NavItem}" GroupName="MainNav"
                       Tag="&#xE896;" Content="下载中心"
                       Command="{Binding NavigateCommand}" CommandParameter="download" />
          <RadioButton Theme="{StaticResource NavItem}" GroupName="MainNav"
                       Tag="&#xE74E;" Content="备份"
                       Command="{Binding NavigateCommand}" CommandParameter="backup" />
          <RadioButton Theme="{StaticResource NavItem}" GroupName="MainNav"
                       Tag="&#xE8A9;" Content="剧情"
                       Command="{Binding NavigateCommand}" CommandParameter="story" />
          <RadioButton Theme="{StaticResource NavItem}" GroupName="MainNav"
                       Tag="&#xE9D9;" Content="诊断"
                       Command="{Binding NavigateCommand}" CommandParameter="diagnostic" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <RadioButton Theme="{StaticResource NavItem}" GroupName="MainNav"
                       Tag="&#xE713;" Content="设置" Margin="0,0,0,10"
                       Command="{Binding NavigateCommand}" CommandParameter="settings" />
          <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="6,0,6,0"
                     Text="每个版本使用独立端口，存档、模组开关与设置互不干扰。" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 导航与内容之间的空隙，P4 换成可拖动分栏 -->
    <Border Grid.Column="1" Background="Transparent" />

    <Grid x:Name="PageHost" Grid.Column="2" Margin="20,18,20,18">

      <!-- 版本管理页 -->
      <Grid IsVisible="{Binding IsVersionsSelected}" ColumnDefinitions="260,*">

        <!-- 版本列表 -->
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="12">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="2,2,2,10">
              <TextBlock Text="游戏版本" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Classes="muted" HorizontalAlignment="Right"
                         Text="{Binding VersionCountText}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="2,10,2,0" TextWrapping="Wrap"
                       Text="每个版本的存档、模组开关、设置都由独立端口隔离。" />

            <ListBox ItemsSource="{Binding Versions}"
                     SelectedItem="{Binding SelectedVersion}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerTheme="{StaticResource VersionItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="3">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right"
                                 Text="{Binding StatusText}"
                                 Classes="status"
                                 Classes.running="{Binding IsRunning}"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- 版本详情 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                CornerRadius="12" Padding="18" Margin="12,0,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,170">

            <DockPanel Grid.Row="0">
              <Border DockPanel.Dock="Right" Background="{DynamicResource AccentPaleBrush}" CornerRadius="6"
                      Padding="9,4" VerticalAlignment="Top" Margin="10,3,0,0">
                <TextBlock Text="{Binding BadgeMode}" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <StackPanel>
                <TextBlock Text="{Binding TitleText}" FontSize="21" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SubText}" Classes="muted" Margin="0,5,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <WrapPanel Grid.Row="1" Margin="0,16,0,0">
              <Button Content="{Binding LaunchText}" Tag="&#xE768;"
                      Theme="{StaticResource IconPrimaryButton}"
                      Command="{Binding LaunchCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding ProblemText}" Tag="&#xE7BA;"
                      Theme="{StaticResource IconButton}"
                      Classes.problem="True"
                      Classes.warn="{Binding HasProblems}"
                      Classes.danger="{Binding HasDanger}"
                      Command="{Binding ShowProblemsCommand}" Margin="0,0,8,8"
                      ToolTip.Tip="检查模组冲突、版本不匹配与缺少前置" />
              <Button Content="停止" Tag="&#xE71A;"
                      Theme="{StaticResource IconButton}"
                      Command="{Binding StopCommand}" Margin="0,0,8,8" />
              <Button Content="打开目录" Tag="&#xE8B7;"
                      Theme="{StaticResource IconButton}"
                      Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Grid.Row="2" Text="{Binding PathText}" Classes="muted"
                       FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,14" />

            <DockPanel Grid.Row="3">
              <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="导入" Theme="{StaticResource TinyButton}" Width="52"
                        Command="{Binding ImportModsCommand}"
                        ToolTip.Tip="导入模组 zip（也可以直接把 zip 拖进下面的列表）" />
                <Button Content="删除" Theme="{StaticResource TinyButton}" Width="52" Margin="6,0,0,0"
                        Command="{Binding DeleteModsCommand}"
                        ToolTip.Tip="删除选中的模组（可多选）" />
                <Button Content="刷新" Theme="{StaticResource TinyButton}" Width="52" Margin="6,0,0,0"
                        Command="{Binding RefreshModsCommand}" />
              </WrapPanel>
              <TextBlock Text="模组" Classes="section" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ModCountText}" Classes="muted" Margin="10,0,0,0"
                         VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="4" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,4" />

            <ListBox x:Name="ModsList" Grid.Row="5"
                     ItemsSource="{Binding Mods}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Multiple"
                     ItemContainerTheme="{StaticResource ModItem}"
                     DragDrop.AllowDrop="True"
                     ToolTip.Tip="点一行选中；Ctrl / Shift 多选">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0"
                              ToolTip.Tip="只控制启用 / 停用；选中模组请点这一行" />
                    <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="13"
                                 Foreground="{DynamicResource TextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding IssueText}" FontSize="11"
                                 Foreground="{DynamicResource WarnBrush}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasIssue}" />
                      <TextBlock Text="{Binding ConflictText}" FontSize="11"
                                 Foreground="{DynamicResource DangerBrush}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasConflict}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                      <Button Content="↑" Theme="{StaticResource TinyButton}"
                              Command="{Binding $parent[Window].DataContext.MoveUpCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="提前加载" />
                      <Button Content="↓" Theme="{StaticResource TinyButton}"
                              Command="{Binding $parent[Window].DataContext.MoveDownCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="延后加载" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="6" Text="运行记录" Classes="section" Margin="0,8,0,6" />

            <TextBox x:Name="LogBox" Grid.Row="7"
                     Text="{Binding LogText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}"
                     Background="{DynamicResource BgBrush}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </Border>
      </Grid>

      <!-- 设置页 -->
      <Border IsVisible="{Binding IsSettingsSelected}">
        <views:SettingsPage DataContext="{Binding Settings}" />
      </Border>

      <!-- 下载中心 -->
      <Border IsVisible="{Binding IsDownloadSelected}">
        <views:DownloadPage DataContext="{Binding Download}" />
      </Border>

      <!-- 备份 -->
      <Border IsVisible="{Binding IsBackupSelected}">
        <views:BackupPage DataContext="{Binding Backup}" />
      </Border>

      <!-- 诊断 -->
      <Border IsVisible="{Binding IsDiagnosticSelected}">
        <views:DiagnosticPage DataContext="{Binding Diagnostic}" />
      </Border>

      <!-- 剧情 -->
      <Border IsVisible="{Binding IsStorySelected}">
        <views:StoryPage DataContext="{Binding Story}" />
      </Border>

      <!-- 其余页面的占位 -->
      <StackPanel IsVisible="{Binding IsPlaceholderVisible}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="{Binding PlaceholderText}"
                   Foreground="{DynamicResource MutedBrush}" FontSize="14"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Avalonia 跨平台骨架已就绪"
                   Foreground="{DynamicResource MutedBrush}" FontSize="11"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
