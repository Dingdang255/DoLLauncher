<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DoLLauncher.Views.InstallCheckWindow"
        Title="安装前检查"
        Width="660" Height="560" MinWidth="560" MinHeight="380"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Noto Sans CJK SC, Segoe UI"
        FontSize="13">

  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Classes="muted"
               Margin="0,8,0,0" TextWrapping="Wrap" />

    <ScrollViewer Grid.Row="2" Margin="0,16,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <StackPanel IsVisible="{Binding HasDependencies}">
          <TextBlock Text="需要补装的前置" Classes="section" />
          <TextBlock Classes="muted" Margin="0,5,0,0" TextWrapping="Wrap"
                     Text="默认已勾选；取消勾选就只安装主模组，前置需要你自己补。" />
          <ItemsControl ItemsSource="{Binding Dependencies}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,12" ColumnDefinitions="Auto,*">
                  <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                            VerticalAlignment="Top" Margin="0,3,12,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasSatisfied}" Margin="0,6,0,0">
          <TextBlock Text="已满足的前置" Classes="section" />
          <ItemsControl ItemsSource="{Binding Satisfied}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasConflicts}" Margin="0,14,0,0">
          <TextBlock Text="可能冲突（本地已装模组）" Classes="section" />
          <ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasNotes}" Margin="0,14,0,0">
          <TextBlock Text="提示" Classes="section" />
          <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,5" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="没有发现缺失前置，也没有与本地已装模组冲突。"
                   Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0"
                   IsVisible="{Binding IsEmpty}" />
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Text="{Binding FootHint}" DockPanel.Dock="Left" Classes="muted"
                 VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Theme="{StaticResource FlatButton}" Width="92" Click="OnCancelClick" />
        <Button Content="开始安装" Theme="{StaticResource PrimaryButton}" Width="120"
                Margin="10,0,0,0" Click="OnInstallClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
