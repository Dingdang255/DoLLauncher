<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoLLauncher.Maui.VersionDetailPage"
             Title="版本详情">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

                <VerticalStackLayout Spacing="2">
                    <Label x:Name="NameLabel" FontSize="24" FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="SubLabel" FontSize="12"
                           LineBreakMode="MiddleTruncation"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                </VerticalStackLayout>

                <!-- 版本信息 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="版本信息" FontSize="15" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="6" ColumnSpacing="8">
                            <Label Grid.Row="0" Grid.Column="0" Text="游戏版本" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                            <Label x:Name="GameVersionLabel" Grid.Row="0" Grid.Column="1" FontSize="13" />

                            <Label Grid.Row="1" Grid.Column="0" Text="模式" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                            <Label x:Name="ModeLabel" Grid.Row="1" Grid.Column="1" FontSize="13" />

                            <Label Grid.Row="2" Grid.Column="0" Text="本地端口" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                            <Label x:Name="PortLabel" Grid.Row="2" Grid.Column="1" FontSize="13" />

                            <Label Grid.Row="3" Grid.Column="0" Text="运行状态" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                            <Label x:Name="StatusLabel" Grid.Row="3" Grid.Column="1" FontSize="13" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="版本目录" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="PathLabel" FontSize="11"
                                       LineBreakMode="CharacterWrap"
                                       TextColor="{AppThemeBinding Light=#4A4A4A, Dark=#C8C8C8}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="复制" FontSize="12" Padding="0"
                                    HeightRequest="32" WidthRequest="52" CornerRadius="8"
                                    VerticalOptions="End"
                                    Clicked="OnCopyPathClicked"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 操作 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="操作" FontSize="15" FontAttributes="Bold" />

                        <Button x:Name="LaunchButton" Text="启动游戏"
                                HeightRequest="48" CornerRadius="10"
                                FontSize="16" FontAttributes="Bold"
                                Clicked="OnLaunchClicked" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="StopButton" Grid.Column="0" Text="停止"
                                    HeightRequest="42" CornerRadius="10" FontSize="14"
                                    IsEnabled="False"
                                    Clicked="OnStopClicked"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                            <Button x:Name="ProblemButton" Grid.Column="1" Text="未发现问题"
                                    HeightRequest="42" CornerRadius="10" FontSize="14"
                                    IsEnabled="False"
                                    Clicked="OnProblemClicked"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                        </Grid>

                        <Button x:Name="HelperButton" Text="存档助手"
                                HeightRequest="42" CornerRadius="10" FontSize="14"
                                Clicked="OnHelperClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />

                        <Button x:Name="ExportButton" Text="导出版本包"
                                HeightRequest="42" CornerRadius="10" FontSize="14"
                                Clicked="OnExportClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />

                        <Button x:Name="DeleteButton" Text="删除版本"
                                HeightRequest="42" CornerRadius="10" FontSize="14"
                                Clicked="OnDeleteClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="#C62828" />
                    </VerticalStackLayout>
                </Border>

                <!-- 问题列表 -->
                <Border x:Name="ProblemPanel" IsVisible="False" Padding="14"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="问题详情" FontSize="15" FontAttributes="Bold" />
                        <VerticalStackLayout x:Name="ProblemList" Spacing="8" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 导出选项 -->
        <Grid x:Name="ExportOverlay" IsVisible="False" BackgroundColor="#80000000">
            <Border Padding="18" Margin="24" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="导出为版本包" FontSize="16" FontAttributes="Bold" />
                    <Label x:Name="ExportInfoLabel" FontSize="11" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <HorizontalStackLayout Spacing="4">
                        <CheckBox x:Name="ExportIncludeGameCheck" IsChecked="True" />
                        <Label Text="包含游戏本体与版本文件" FontSize="13"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="不勾选时只打包模组清单，导入到已有版本即可使用。导出后会让你选择保存位置。"
                           FontSize="11" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="取消" HeightRequest="40" CornerRadius="9"
                                FontSize="14" Clicked="OnExportCancelClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                        <Button Grid.Column="1" Text="导出" HeightRequest="40" CornerRadius="9"
                                FontSize="14" Clicked="OnExportConfirmClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="BusyOverlay" IsVisible="False" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True" Color="White"
                               VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
