<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:DoLLauncher.Maui.Controls"
             xmlns:local="clr-namespace:DoLLauncher.Maui"
             x:Class="DoLLauncher.Maui.VersionDetailPage"
             Title="版本详情">

    <Grid>

        <ScrollView>
            <Grid Padding="16,12,16,20" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="14">

                <!-- 左列：版本信息与路径 -->
                <VerticalStackLayout Grid.Column="0" Spacing="12">

                    <VerticalStackLayout Spacing="3">
                        <Label x:Name="NameLabel" FontSize="22" FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label x:Name="SubLabel" FontSize="12"
                               LineBreakMode="MiddleTruncation"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="版本信息" Style="{StaticResource SettingsItemTitle}" />

                            <Grid ColumnDefinitions="82,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="8" ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0" Text="游戏版本" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="GameVersionLabel" Grid.Row="0" Grid.Column="1" FontSize="13" />

                                <Label Grid.Row="1" Grid.Column="0" Text="模式" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="ModeLabel" Grid.Row="1" Grid.Column="1" FontSize="13" />

                                <Label Grid.Row="2" Grid.Column="0" Text="本地端口" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="PortLabel" Grid.Row="2" Grid.Column="1" FontSize="13" />

                                <Label Grid.Row="3" Grid.Column="0" Text="运行状态" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="StatusLabel" Grid.Row="3" Grid.Column="1" FontSize="13"
                                       FontAttributes="Bold" />
                            </Grid>

                            <BoxView HeightRequest="1" Opacity="0.15" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="版本目录" FontSize="13"
                                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                    <Label x:Name="PathLabel" FontSize="11"
                                           LineBreakMode="CharacterWrap"
                                           TextColor="{AppThemeBinding Light=#4A4A4A, Dark=#C8C8C8}" />
                                </VerticalStackLayout>
                                <ctl:IconActionView Grid.Column="1" Glyph="{x:Static local:IconGlyph.FolderOpen}"
                                                    Text="打开" IsCompact="True"
                                                    VerticalOptions="Start"
                                                    Tapped="OnOpenFolderClicked" />
                                <ctl:IconActionView Grid.Column="2" Glyph="{x:Static local:IconGlyph.Copy}"
                                                    Text="复制" IsCompact="True"
                                                    VerticalOptions="Start"
                                                    Tapped="OnCopyPathClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 问题列表 -->
                    <Border x:Name="ProblemPanel" IsVisible="False" Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="问题详情" Style="{StaticResource SettingsItemTitle}" />
                            <VerticalStackLayout x:Name="ProblemList" Spacing="8" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- 右列：操作 -->
                <VerticalStackLayout Grid.Column="1" Spacing="12">
                    <Border Style="{StaticResource SettingsCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="操作" Style="{StaticResource SettingsItemTitle}" />

                            <ctl:IconActionView x:Name="LaunchButton" Glyph="{x:Static local:IconGlyph.Play}"
                                                Text="启动游戏" Variant="primary"
                                                MinimumHeightRequest="46"
                                                Tapped="OnLaunchClicked" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowSpacing="8"
                                  RowDefinitions="Auto,Auto,Auto,Auto">
                                <ctl:IconActionView x:Name="StopButton" Grid.Row="0" Grid.Column="0"
                                                    Glyph="{x:Static local:IconGlyph.Stop}"
                                                    Text="停止" IsEnabled="False"
                                                    Tapped="OnStopClicked" />
                                <ctl:IconActionView x:Name="ProblemButton" Grid.Row="0" Grid.Column="1"
                                                    Glyph="{x:Static local:IconGlyph.Warning}"
                                                    Text="未发现问题" IsEnabled="False"
                                                    Tapped="OnProblemClicked" />
                                <ctl:IconActionView x:Name="HelperButton" Grid.Row="1" Grid.Column="0"
                                                    Glyph="{x:Static local:IconGlyph.Save}"
                                                    Text="存档助手"
                                                    Tapped="OnHelperClicked" />
                                <ctl:IconActionView x:Name="ExportButton" Grid.Row="1" Grid.Column="1"
                                                    Glyph="{x:Static local:IconGlyph.Box}"
                                                    Text="导出版本包"
                                                    Tapped="OnExportClicked" />
                                <ctl:IconActionView x:Name="IntegrityButton" Grid.Row="2" Grid.ColumnSpan="2"
                                                    Glyph="{x:Static local:IconGlyph.CheckmarkCircle}"
                                                    Text="完整性检查"
                                                    Tapped="OnIntegrityClicked" />
                                <ctl:IconActionView x:Name="DeleteButton" Grid.Row="3" Grid.ColumnSpan="2"
                                                    Glyph="{x:Static local:IconGlyph.Delete}"
                                                    Text="删除版本" Variant="danger"
                                                    Tapped="OnDeleteClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label FontSize="10" LineBreakMode="WordWrap"
                           Text="每个版本使用独立端口，存档、模组开关与浏览器数据互不干扰。启动前会先检查模组冲突与版本匹配。"
                           TextColor="{AppThemeBinding Light=#909090, Dark=#909090}" />
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!-- 导出选项 -->
        <Grid x:Name="ExportOverlay" IsVisible="False" BackgroundColor="#80000000">
            <Border Padding="18" Margin="24" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="460"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="导出为版本包" FontSize="16" FontAttributes="Bold" />
                    <Label x:Name="ExportInfoLabel" FontSize="11" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <HorizontalStackLayout Spacing="4">
                        <CheckBox x:Name="ExportIncludeGameCheck" IsChecked="True" />
                        <Label Text="包含游戏本体与版本文件" FontSize="13"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="不勾选时只打包模组清单，导入到已有版本即可使用。导出后会让你选择保存位置。"
                           FontSize="11" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0" Text="取消" HeightRequest="40" CornerRadius="9"
                                FontSize="14" Clicked="OnExportCancelClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                        <Button Grid.Column="1" Text="导出" HeightRequest="40" CornerRadius="9"
                                FontSize="14" Clicked="OnExportConfirmClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid x:Name="BusyOverlay" IsVisible="False" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True" Color="White"
                               VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
