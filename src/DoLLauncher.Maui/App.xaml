<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DoLLauncher.Maui"
             x:Class="DoLLauncher.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 设置页统一卡片 / 标题 / 说明样式 -->
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="14" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}" />
            </Style>

            <Style x:Key="SettingsItemTitle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#202020, Dark=#F0F0F0}" />
            </Style>

            <Style x:Key="SettingsHint" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
