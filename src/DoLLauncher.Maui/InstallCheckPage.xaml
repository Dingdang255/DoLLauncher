<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoLLauncher.Maui.InstallCheckPage"
             Title="安装前检查">

    <Grid RowDefinitions="*,Auto" Padding="16,12,16,12" RowSpacing="12">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14">

                <VerticalStackLayout Spacing="4">
                    <Label x:Name="TitleLabel" FontSize="18" FontAttributes="Bold" />
                    <Label x:Name="SubtitleLabel" FontSize="12"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                </VerticalStackLayout>

                <!-- 逐个模组的安装前检查内容（多选时按排序依次列出，中间有分割线） -->
                <VerticalStackLayout x:Name="PlansList" Spacing="12" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部操作 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label x:Name="FootHint" FontSize="10" VerticalOptions="Center"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
            <Button x:Name="CancelButton" Grid.Column="1" Text="取消" FontSize="13"
                    HeightRequest="38" MinimumHeightRequest="38" WidthRequest="76"
                    CornerRadius="9" Clicked="OnCancelClicked"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
            <Button x:Name="StartButton" Grid.Column="2" Text="开始安装" FontSize="13"
                    HeightRequest="38" MinimumHeightRequest="38" WidthRequest="104"
                    CornerRadius="9" Clicked="OnStartClicked"
                    BackgroundColor="{DynamicResource AccentColor}"
                    TextColor="{DynamicResource AccentOnColor}" />
        </Grid>

    </Grid>

</ContentPage>
