<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>DoLLauncher.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- 显示名称 -->
		<ApplicationTitle>DoL 启动器</ApplicationTitle>

		<!-- 应用标识 -->
		<ApplicationId>com.dol.launcher</ApplicationId>

		<!-- 版本 -->
		<ApplicationDisplayVersion>1.4.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>
		<!-- 版本信息由构建注入为 tag|commit|时间，关闭 SDK 的默认生成以便自行写入 -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

		<!-- 手动 adb 安装 APK 时必须把程序集打包进 APK，否则 Debug 的 Fast Deployment 会缺程序集而闪退 -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- 应用图标：直接取自 WPF 端的 dol.ico（256×256 帧），暖色底 -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#F7EFE2" />

		<!-- 启动屏 -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F7EFE2" BaseSize="128,128" />

		<!-- 图片 -->
		<MauiImage Include="Resources\Images\*" />

		<!-- 字体 -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- 原始资源 -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 平台无关层：版本、模组、下载、日志、本地服务器 -->
		<ProjectReference Include="..\DoLLauncher.Core\DoLLauncher.Core.csproj" />
	</ItemGroup>

	<!-- Release 签名：通过环境变量提供 keystore 路径、别名与密码；未提供时保持 SDK 默认行为 -->
	<PropertyGroup Condition="'$(DOL_KEYSTORE)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(DOL_KEYSTORE)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias Condition="'$(DOL_KEY_ALIAS)' != ''">$(DOL_KEY_ALIAS)</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass Condition="'$(DOL_KEY_PASS)' != ''">env:DOL_KEY_PASS</AndroidSigningKeyPass>
		<AndroidSigningStorePass Condition="'$(DOL_STORE_PASS)' != ''">env:DOL_STORE_PASS</AndroidSigningStorePass>
	</PropertyGroup>

	<!-- 与 build.ps1 相同的版本信息生成逻辑：git tag | 提交 | 构建时间；有未提交改动时按 dev 处理 -->
	<Target Name="InjectDolBuildInfo" BeforeTargets="GenerateAssemblyInfo" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; describe --tags --exact-match"
		      IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_DolTagOutput" />
		</Exec>
		<Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; status --porcelain"
		      IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_DolDirtyOutput" />
		</Exec>
		<Exec Command="git -C &quot;$(MSBuildProjectDirectory)\..\..&quot; rev-parse --short HEAD"
		      IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_DolCommitOutput" />
		</Exec>
		<PropertyGroup>
			<_DolTag>$(_DolTagOutput.Trim())</_DolTag>
			<_DolTag Condition="'$(_DolTag)' == ''">dev</_DolTag>
			<_DolTag Condition="'$(_DolDirtyOutput.Trim())' != ''">dev</_DolTag>
			<_DolCommit>$(_DolCommitOutput.Trim())</_DolCommit>
			<_DolCommit Condition="'$(_DolCommit)' == ''">local</_DolCommit>
			<_DolBuildTime>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</_DolBuildTime>
			<InformationalVersion>$(_DolTag)|$(_DolCommit)|$(_DolBuildTime)</InformationalVersion>
			<ApplicationDisplayVersion Condition="'$(_DolTag)' != 'dev'">$(_DolTag.TrimStart('v'))</ApplicationDisplayVersion>
		</PropertyGroup>

		<!-- 走自己的文件，避开 GenerateAssemblyInfo 的增量缓存不认属性变化的问题 -->
		<ItemGroup>
			<_DolBuildInfoLine Include="// &lt;auto-generated/&gt;" />
			<_DolBuildInfoLine Include="[assembly: System.Reflection.AssemblyInformationalVersionAttribute(&quot;$(_DolTag)|$(_DolCommit)|$(_DolBuildTime)&quot;)]" />
		</ItemGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)DolBuildInfo.g.cs"
		                  Lines="@(_DolBuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)DolBuildInfo.g.cs" />
		</ItemGroup>
	</Target>

</Project>
