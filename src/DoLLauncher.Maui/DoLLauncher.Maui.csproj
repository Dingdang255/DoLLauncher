<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>DoLLauncher.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- 显示名称 -->
		<ApplicationTitle>DoL 启动器</ApplicationTitle>

		<!-- 应用标识 -->
		<ApplicationId>com.dol.launcher</ApplicationId>

		<!-- 版本 -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

		<!-- 手动 adb 安装 APK 时必须把程序集打包进 APK，否则 Debug 的 Fast Deployment 会缺程序集而闪退 -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- 应用图标：使用 DoL 角色头像，暖色底 -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F7EFE2" />

		<!-- 启动屏 -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F7EFE2" BaseSize="128,128" />

		<!-- 图片 -->
		<MauiImage Include="Resources\Images\*" />

		<!-- 字体 -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- 原始资源 -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 平台无关层：版本、模组、下载、日志、本地服务器 -->
		<ProjectReference Include="..\DoLLauncher.Core\DoLLauncher.Core.csproj" />
	</ItemGroup>

</Project>
