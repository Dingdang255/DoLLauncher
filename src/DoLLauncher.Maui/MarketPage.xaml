<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoLLauncher.Maui.MarketPage"
             Title="模组市场">

    <ContentPage.Resources>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="MinimumHeightRequest" Value="32" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
        </Style>
        <Style x:Key="RowToolButton" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HeightRequest" Value="28" />
            <Setter Property="MinimumHeightRequest" Value="28" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}" />
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="RefreshItem" Text="刷新" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="12,10,12,0" RowSpacing="10">

        <!-- 顶部：安装目标、搜索、筛选 -->
        <Border Grid.Row="0" Padding="12" StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
            <VerticalStackLayout Spacing="8">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="安装到版本" FontSize="13" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    <Picker x:Name="VersionPicker" Grid.Column="1" FontSize="13"
                            VerticalOptions="Center"
                            SelectedIndexChanged="OnTargetVersionChanged" />
                    <Label x:Name="HeaderCountLabel" Grid.Column="2" Text="" FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                </Grid>

                <SearchBar x:Name="SearchBox" Placeholder="搜索模组名称 / 作者 / 标签"
                           FontSize="13" TextChanged="OnSearchTextChanged" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="分类" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    <Picker x:Name="CategoryPicker" Grid.Column="1" FontSize="12"
                            VerticalOptions="Center"
                            SelectedIndexChanged="OnFilterChanged" />
                </Grid>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="8" RowSpacing="6">
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="匹配" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Picker x:Name="MatchPicker" Grid.Column="1" FontSize="12"
                                VerticalOptions="Center"
                                SelectedIndexChanged="OnFilterChanged" />
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="范围" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Picker x:Name="ScopePicker" Grid.Column="1" FontSize="12"
                                VerticalOptions="Center"
                                SelectedIndexChanged="OnFilterChanged" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="排序" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Picker x:Name="SortPicker" Grid.Column="1" FontSize="12"
                                VerticalOptions="Center"
                                SelectedIndexChanged="OnFilterChanged" />
                    </Grid>
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="倒序" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Switch x:Name="DescSwitch" VerticalOptions="Center" Toggled="OnSortDescToggled" />
                    </HorizontalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                    <Button x:Name="ChipAll" Grid.Column="0" Text="全部模组"
                            Style="{StaticResource ChipButton}" Clicked="OnChipAllClicked" />
                    <Button x:Name="ChipUninstalled" Grid.Column="1" Text="未安装"
                            Style="{StaticResource ChipButton}" Clicked="OnChipUninstalledClicked" />
                    <Button x:Name="ChipUpdatable" Grid.Column="2" Text="可更新"
                            Style="{StaticResource ChipButton}" Clicked="OnChipUpdatableClicked" />
                    <Label x:Name="FilterCountLabel" Grid.Column="4" Text="" FontSize="12"
                           VerticalOptions="Center" HorizontalOptions="End"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 列表 / 加载 / 错误 -->
        <Grid Grid.Row="1">
            <CollectionView x:Name="MarketList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label x:Name="EmptyLabel" Text="没有符合条件的模组" FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                            <VerticalStackLayout Spacing="6">

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding Mod.Title}" FontSize="15"
                                               FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Mod.Subtitle}" FontSize="11"
                                               LineBreakMode="MiddleTruncation"
                                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding Mod.BadgeText}" FontSize="11"
                                                   IsVisible="{Binding Mod.Installed}"
                                                   TextColor="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}" />
                                            <Label Text="{Binding StarText}" FontSize="11"
                                                   IsVisible="{Binding HasStar}"
                                                   TextColor="{AppThemeBinding Light=#B25B00, Dark=#FFCC80}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="安装" FontSize="13"
                                            Padding="14,0" HeightRequest="32" MinimumHeightRequest="32"
                                            WidthRequest="62" CornerRadius="8"
                                            VerticalOptions="Start"
                                            Clicked="OnInstallClicked"
                                            BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7B5BD6}"
                                            TextColor="White" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="版本选择"
                                            Style="{StaticResource RowToolButton}"
                                            Clicked="OnRowVersionsClicked" />
                                    <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="10"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                </Grid>

                                <VerticalStackLayout IsVisible="{Binding ShowVersionPanel}" Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="历史版本" FontSize="11" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                        <Picker Grid.Column="1" FontSize="12" VerticalOptions="Center"
                                                ItemsSource="{Binding Releases}"
                                                SelectedIndex="{Binding SelectedReleaseIndex, Mode=TwoWay}"
                                                SelectedIndexChanged="OnRowReleaseChanged">
                                            <Picker.ItemDisplayBinding>
                                                <Binding Path="DisplayName" />
                                            </Picker.ItemDisplayBinding>
                                        </Picker>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                          IsVisible="{Binding HasEditions}">
                                        <Label Text="包型" FontSize="11" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                        <Picker Grid.Column="1" FontSize="12" VerticalOptions="Center"
                                                ItemsSource="{Binding Editions}"
                                                SelectedIndex="{Binding SelectedEditionIndex, Mode=TwoWay}"
                                                SelectedIndexChanged="OnRowEditionChanged">
                                            <Picker.ItemDisplayBinding>
                                                <Binding Path="Display" />
                                            </Picker.ItemDisplayBinding>
                                        </Picker>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="包版本" FontSize="11" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                        <Picker Grid.Column="1" FontSize="12" VerticalOptions="Center"
                                                ItemsSource="{Binding Assets}"
                                                SelectedIndex="{Binding SelectedAssetIndex, Mode=TwoWay}">
                                            <Picker.ItemDisplayBinding>
                                                <Binding Path="Display" />
                                            </Picker.ItemDisplayBinding>
                                        </Picker>
                                    </Grid>
                                    <Button Text="加载版本" IsVisible="{Binding LoadVersionVisible}"
                                            Style="{StaticResource RowToolButton}"
                                            HorizontalOptions="Start"
                                            Clicked="OnRowLoadVersionsClicked" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 加载中 -->
            <VerticalStackLayout x:Name="LoadingPanel" IsVisible="False" Spacing="10"
                                 VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />
                <Label Text="正在加载模组市场…" FontSize="13"
                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
            </VerticalStackLayout>

            <!-- 加载失败 -->
            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Padding="24" Spacing="12"
                                 VerticalOptions="Center">
                <Label x:Name="ErrorLabel" FontSize="13" HorizontalTextAlignment="Center" />
                <Button Text="重试" HorizontalOptions="Center" Padding="18,0"
                        HeightRequest="34" MinimumHeightRequest="34" CornerRadius="8"
                        Clicked="OnRetryClicked" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
