<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:DoLLauncher.Maui.Controls"
             x:Class="DoLLauncher.Maui.UpdateDialogPage"
             Title="发现新版本">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16,12,16,12" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="发现新版本" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="SubtitleLabel" FontSize="12"
                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="更新内容" Style="{StaticResource SettingsItemTitle}" />
                        <ctl:MarkdownView x:Name="ChangelogView" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ProgressPanel" IsVisible="False" Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="下载安装包" Style="{StaticResource SettingsItemTitle}" />
                        <ProgressBar x:Name="DownloadProgress" Progress="0" HeightRequest="6"
                                     ProgressColor="{DynamicResource AccentColor}" />
                        <Label x:Name="ProgressText" Style="{StaticResource SettingsHint}" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="FailurePanel" IsVisible="False" Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="自动更新未完成" FontSize="13" FontAttributes="Bold" TextColor="#C62828" />
                        <Label x:Name="FailureText" Style="{StaticResource SettingsHint}" />
                        <Button Text="在浏览器中打开 Release 页面" FontSize="12" Padding="10,4"
                                CornerRadius="8" HeightRequest="34" HorizontalOptions="Start"
                                Clicked="OnManualDownload"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel" IsVisible="False" Style="{StaticResource SettingsHint}" />

            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Spacing="6">
            <CheckBox x:Name="SkipTodayCheck" VerticalOptions="Center" />
            <Label Text="今日内不再提醒" FontSize="12" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Label FontSize="10" VerticalOptions="Center" LineBreakMode="WordWrap"
                   Text="下载完成后会交给系统安装程序，需要在系统界面确认安装。"
                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
            <Button x:Name="LaterButton" Grid.Column="1" Text="稍后" FontSize="13"
                    HeightRequest="38" MinimumHeightRequest="38" WidthRequest="76"
                    CornerRadius="9" Clicked="OnLaterClicked"
                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
            <Button x:Name="UpdateButton" Grid.Column="2" Text="立即更新" FontSize="13"
                    HeightRequest="38" MinimumHeightRequest="38" WidthRequest="104"
                    CornerRadius="9" Clicked="OnUpdateClicked"
                    BackgroundColor="{DynamicResource AccentColor}"
                    TextColor="{DynamicResource AccentOnColor}" />
        </Grid>

    </Grid>

</ContentPage>
