<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoLLauncher.Maui.MainPage"
             Title="DoL 启动器">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="下载" Clicked="OnDownloadClicked" />
        <ToolbarItem Text="导入版本" Clicked="OnImportClicked" />
        <ToolbarItem Text="设置" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="DoL 启动器" FontSize="26" FontAttributes="Bold" />
            <Label x:Name="RootLabel" FontSize="11" TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}"
                   LineBreakMode="MiddleTruncation" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing" Margin="0,12,0,0">
            <CollectionView x:Name="VersionList" SelectionMode="Single" SelectionChanged="OnVersionSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="还没有版本" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="把游戏版本文件夹放进 versions 目录，然后下拉刷新。"
                               HorizontalTextAlignment="Center" FontSize="13"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding DisplayName}" FontSize="17" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Folder}" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="模组" FontSize="12" Padding="0"
                                            HeightRequest="32" WidthRequest="52" CornerRadius="8"
                                            Clicked="OnModsClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                            TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                                    <Button Text="备份" FontSize="12" Padding="0"
                                            HeightRequest="32" WidthRequest="52" CornerRadius="8"
                                            Clicked="OnBackupClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                            TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                                    <Button Text="诊断" FontSize="12" Padding="0"
                                            HeightRequest="32" WidthRequest="52" CornerRadius="8"
                                            Clicked="OnDiagnosticsClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                            TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                                    <Button Text="剧情" FontSize="12" Padding="0"
                                            HeightRequest="32" WidthRequest="52" CornerRadius="8"
                                            Clicked="OnStoryClicked"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                            TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="2" IsVisible="False"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True" Color="White"
                               VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
