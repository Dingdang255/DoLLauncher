<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:DoLLauncher.Maui.Controls"
             xmlns:local="clr-namespace:DoLLauncher.Maui"
             x:Class="DoLLauncher.Maui.MainPage"
             Title="DoL 启动器">

    <Grid ColumnDefinitions="224,*" Padding="16,14" ColumnSpacing="16">

        <!-- 左侧导航（对应 WPF 的 PCL 式侧边栏） -->
        <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                StyleClass="sidebar card"
                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#242424}"
                Padding="14,16">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">

                <VerticalStackLayout Grid.Row="0" Spacing="4">
                    <HorizontalStackLayout Spacing="9">
                        <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{DynamicResource AccentPaleColor}">
                            <Grid>
                                <Label x:Name="AvatarPlaceholder" Text="{x:Static local:IconGlyph.Person}"
                                       FontFamily="FluentIcons" FontSize="18"
                                       TextColor="{DynamicResource AccentColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image x:Name="AvatarImage" Aspect="AspectFill" IsVisible="False" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="DoL 启动器" FontSize="18" FontAttributes="Bold" />
                            <Label x:Name="SubtitleLabel" FontSize="10" IsVisible="False"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label x:Name="RootLabel" FontSize="10"
                           LineBreakMode="MiddleTruncation"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="8">
                    <ctl:IconActionView x:Name="NavVersions" Glyph="{x:Static local:IconGlyph.Window}"
                                        Text="版本管理" Variant="pale" Tapped="OnVersionsNavClicked" />
                    <ctl:IconActionView x:Name="NavDownload" Glyph="{x:Static local:IconGlyph.ArrowDownload}"
                                        Text="下载中心" Variant="plain" Tapped="OnDownloadNavClicked" />
                    <ctl:IconActionView x:Name="NavBackup" Glyph="{x:Static local:IconGlyph.Archive}"
                                        Text="备份" Variant="plain" Tapped="OnBackupNavClicked" />
                    <ctl:IconActionView x:Name="NavStory" Glyph="{x:Static local:IconGlyph.Book}"
                                        Text="剧情" Variant="plain" Tapped="OnStoryNavClicked" />
                    <ctl:IconActionView x:Name="NavDiagnostics" Glyph="{x:Static local:IconGlyph.Bug}"
                                        Text="诊断" Variant="plain" Tapped="OnDiagnosticNavClicked" />
                </VerticalStackLayout>

                <!-- 美化包声明式组件的固定插槽（默认空，不影响原有布局） -->
                <VerticalStackLayout Grid.Row="2" x:Name="SkinHost" Spacing="8"
                                     VerticalOptions="Start" />

                <VerticalStackLayout Grid.Row="3" Spacing="8">
                    <ctl:IconActionView Glyph="{x:Static local:IconGlyph.Settings}"
                                        Text="设置" Tapped="OnSettingsClicked" />
                    <Label FontSize="10" LineBreakMode="WordWrap"
                           Text="每个版本使用独立端口，存档、模组开关与设置互不干扰。"
                           TextColor="{AppThemeBinding Light=#909090, Dark=#909090}" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!-- 右侧：版本列表 或 内嵌面板（替换显示，不压栈） -->
        <Grid Grid.Column="1">
            <Grid x:Name="VersionsPane" RowDefinitions="Auto,*" RowSpacing="10">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="游戏版本" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
                               StyleClass="pane-title" StyleId="VersionsTitle" />
                        <Label x:Name="VersionCountLabel" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </HorizontalStackLayout>
                    <Grid Grid.Column="1" WidthRequest="46" HeightRequest="40">
                        <ctl:IconActionView x:Name="RefreshButton" Glyph="{x:Static local:IconGlyph.ArrowClockwise}"
                                            Variant="pale" IsCompact="True" Tapped="OnRefreshClicked"
                                            HorizontalOptions="Center" VerticalOptions="Center" />
                        <ActivityIndicator x:Name="RefreshSpinner" IsVisible="False" IsRunning="False"
                                           WidthRequest="24" HeightRequest="24"
                                           Color="{DynamicResource AccentColor}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                    <ctl:IconActionView Grid.Column="2" Glyph="{x:Static local:IconGlyph.ArrowImport}"
                                        Text="导入" Variant="primary" Tapped="OnImportClicked" />
                </Grid>

                <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing">
                    <CollectionView x:Name="VersionList" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                                <Label Text="还没有版本" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="把游戏版本文件夹放进 versions 目录，然后点右上角刷新。"
                                       HorizontalTextAlignment="Center" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:MainVersionRow">
                                <Border Padding="12" Margin="0,0,0,8"
                                        StrokeThickness="0"
                                        StyleClass="card version-card"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#2A2A2A}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Grid Grid.Column="0" Grid.ColumnSpan="2"
                                              ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRowTapped" />
                                            </Grid.GestureRecognizers>
                                            <Border Grid.Column="0" WidthRequest="42" HeightRequest="42"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{DynamicResource AccentPaleColor}">
                                                <Label Text="{x:Static local:IconGlyph.Window}" FontFamily="FluentIcons"
                                                       FontSize="20" TextColor="{DynamicResource AccentColor}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold"
                                                       StyleClass="version-title"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" FontSize="11"
                                                       StyleClass="version-subtitle"
                                                       LineBreakMode="MiddleTruncation"
                                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Label Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                               TextColor="{Binding StatusColor}"
                                               VerticalOptions="Center" />

                                        <ctl:IconActionView Grid.Column="3" Glyph="{x:Static local:IconGlyph.PuzzlePiece}"
                                                            Text="模组管理" Variant="pale"
                                                            IsVisible="{Binding CanManageMods}"
                                                            Tapped="OnRowModsClicked"
                                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <ContentView x:Name="PanelHost" IsVisible="False" />
        </Grid>

        <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" IsVisible="False"
              BackgroundColor="#80000000" InputTransparent="False">
            <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="White" HorizontalOptions="Center" />
                <Label x:Name="BusyLabel" Text="正在导入…" FontSize="12" TextColor="White"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
