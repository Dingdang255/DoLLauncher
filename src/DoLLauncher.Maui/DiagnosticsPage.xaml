<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:DoLLauncher.Models;assembly=DoLLauncher.Core"
             x:Class="DoLLauncher.Maui.DiagnosticsPage">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="0,12,16,24" Spacing="12">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label x:Name="HeaderLabel" Grid.Column="0" FontSize="22" FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Button x:Name="ExportButton" Grid.Column="1" Text="导出诊断包" FontSize="13" Padding="16,0"
                            HeightRequest="36" MinimumHeightRequest="36" CornerRadius="9"
                            VerticalOptions="Center" Clicked="OnExportClicked"
                            BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                            TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                </Grid>

                <!-- 诊断模式（与 WPF 一致：手动分析历史日志 / 实时统计当前实例） -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="诊断模式" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                            <Picker x:Name="ModePicker" Grid.Column="1" FontSize="13"
                                    VerticalOptions="Center" SelectedIndexChanged="OnModeChanged">
                                <Picker.Items>
                                    <x:String>手动诊断</x:String>
                                    <x:String>实时诊断</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                        <Label x:Name="ModeHintLabel" FontSize="11" LineBreakMode="WordWrap"
                               Text="手动诊断：分析最近一次游戏日志；实时诊断：每 2 秒统计当前游戏实例并给出诊断。"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 目标版本 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="目标版本" FontSize="13" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Picker x:Name="VersionPicker" Grid.Column="1" FontSize="13"
                                VerticalOptions="Center"
                                ItemDisplayBinding="{Binding DisplayName, x:DataType=models:VersionInfo}"
                                SelectedIndexChanged="OnVersionChanged" />
                    </Grid>
                </Border>

                <!-- 运行环境 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="运行环境" FontSize="15" FontAttributes="Bold" />
                        <VerticalStackLayout x:Name="EnvList" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <!-- 兼容性检查 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="兼容性检查" FontSize="15" FontAttributes="Bold" />
                        <VerticalStackLayout x:Name="CompatList" Spacing="2" />
                    </VerticalStackLayout>
                </Border>

                <!-- 最近游戏日志 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="最近游戏日志" FontSize="15" FontAttributes="Bold" />
                        <VerticalStackLayout x:Name="GameLogList" Spacing="6" />

                        <Label x:Name="GameLogTitle" FontSize="12" IsVisible="False"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Border x:Name="GameLogPanel" IsVisible="False" Padding="10" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenGameLogViewer" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="点击打开独立查看界面" FontSize="10"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="GameLogContent" FontSize="11" FontFamily="monospace"
                                       MaxLines="10" LineBreakMode="CharacterWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 日志分析与上报状态 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="日志分析" FontSize="15" FontAttributes="Bold" />

                        <Label Text="本次日志上报状态" FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#606060, Dark=#B0B0B0}" />
                        <Label x:Name="LogStatusLabel" FontSize="12"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                        <Button x:Name="AnalyzeButton" Text="分析最近日志" FontSize="13"
                                HeightRequest="36" CornerRadius="8"
                                HorizontalOptions="Start" Padding="18,0"
                                Clicked="OnAnalyzeClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />

                        <Border x:Name="AnalysisPanel" IsVisible="False" Padding="10" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenAnalysisViewer" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="点击打开独立查看界面" FontSize="10"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="AnalysisView" FontSize="11" FontFamily="monospace"
                                       MaxLines="12" LineBreakMode="CharacterWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 启动器日志 -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="启动器日志" FontSize="15" FontAttributes="Bold" />
                        <Label x:Name="LauncherLogHint" FontSize="11"
                               LineBreakMode="MiddleTruncation"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Border Padding="10" StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenLauncherLogViewer" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="点击打开独立查看界面" FontSize="10"
                                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                                <Label x:Name="LauncherLogView" FontSize="11" FontFamily="monospace"
                                       MaxLines="12" LineBreakMode="CharacterWrap" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="分享日志" FontSize="13" HeightRequest="36" CornerRadius="8"
                                HorizontalOptions="Start" Padding="18,0"
                                Clicked="OnShareLogClicked"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 存储维护（与 WPF 诊断页一致） -->
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="存储维护" FontSize="15" FontAttributes="Bold" />
                        <Label FontSize="11" LineBreakMode="WordWrap"
                               Text="清除该版本的 Mod 缓存与 Mod 本地设置，保留 saves/details 存档；下次启动该版本时自动执行并重新加载页面。建议先关闭正在运行的游戏页面。"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        <Button Text="清空 Mod 缓存（保留存档）" FontSize="13"
                                HeightRequest="38" CornerRadius="8" HorizontalOptions="Start"
                                Padding="18,0" Clicked="OnClearModCacheClicked"
                                BackgroundColor="{AppThemeBinding Light=#D93B3B, Dark=#A32B2B}"
                                TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Label FontSize="11" HorizontalTextAlignment="Center"
                       Text="日志只显示末尾内容，长行与超长日志会被截断。"
                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="BusyOverlay" IsVisible="False" BackgroundColor="#80000000"
              InputTransparent="False">
            <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="White" HorizontalOptions="Center" />
                <Label x:Name="BusyLabel" Text="处理中…" FontSize="12" TextColor="White"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentView>
