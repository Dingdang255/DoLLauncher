<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctl="clr-namespace:DoLLauncher.Maui.Controls"
             xmlns:local="clr-namespace:DoLLauncher.Maui"
             x:Class="DoLLauncher.Maui.ModsPage"
             Title="模组">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,0">

        <!-- 标题与计数 -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
            <Label Text="模组" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            <Label x:Name="CountLabel" FontSize="12" VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
        </HorizontalStackLayout>

        <!-- 工具条与批量栏 -->
        <VerticalStackLayout Grid.Row="1" Spacing="6" Margin="0,8,0,10">
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="6">
                    <ctl:IconActionView x:Name="ImportButton" Glyph="{x:Static local:IconGlyph.ArrowImport}"
                                        Text="导入" Tapped="OnImportClicked" />
                    <ctl:IconActionView x:Name="CheckButton" Glyph="{x:Static local:IconGlyph.Shield}"
                                        Text="检查" Tapped="OnCheckClicked" />
                    <ctl:IconActionView x:Name="RefreshButton" Glyph="{x:Static local:IconGlyph.ArrowClockwise}"
                                        Text="刷新" Tapped="OnRefreshClicked" />
                    <ctl:IconActionView x:Name="ProblemsButton" Glyph="{x:Static local:IconGlyph.Warning}"
                                        Text="问题" Tapped="OnProblemsClicked" />
                    <ctl:IconActionView x:Name="SelectButton" Glyph="{x:Static local:IconGlyph.List}"
                                        Text="选择" Tapped="OnSelectClicked" />
                </HorizontalStackLayout>
            </ScrollView>

            <HorizontalStackLayout x:Name="BulkBar" IsVisible="False" Spacing="6">
                <Label x:Name="BulkCountLabel" Text="已选 0 个" FontSize="12"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                <ctl:IconActionView Glyph="{x:Static local:IconGlyph.List}" Text="全选"
                                    Tapped="OnSelectAllClicked" />
                <ctl:IconActionView x:Name="BulkDetailButton" Glyph="{x:Static local:IconGlyph.Info}"
                                    Text="详情" IsEnabled="False" Tapped="OnDetailClicked" />
                <ctl:IconActionView x:Name="BulkRenameButton" Glyph="{x:Static local:IconGlyph.Edit}"
                                    Text="重命名" IsEnabled="False" Tapped="OnRenameClicked" />
                <ctl:IconActionView x:Name="BulkEnableButton" Glyph="{x:Static local:IconGlyph.CheckmarkCircle}"
                                    Text="启用" IsEnabled="False" Tapped="OnEnableClicked" />
                <ctl:IconActionView x:Name="BulkDisableButton" Glyph="{x:Static local:IconGlyph.Dismiss}"
                                    Text="停用" IsEnabled="False" Tapped="OnDisableClicked" />
                <ctl:IconActionView x:Name="BulkDeleteButton" Glyph="{x:Static local:IconGlyph.Delete}"
                                    Text="删除" Variant="danger" IsEnabled="False" Tapped="OnDeleteClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <RefreshView x:Name="Refresher" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView x:Name="ModList" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                        <Label Text="还没有模组，可用上方「导入」导入模组包"
                               HorizontalTextAlignment="Center" FontSize="14"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBorder" Padding="12" Margin="0,0,0,10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#3378A9FF" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" VerticalOptions="Center"
                                          IsVisible="{Binding IsMultiSelect}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          CheckedChanged="OnRowChecked" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"
                                                     BackgroundColor="Transparent">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRowTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNormalMode}" Value="True">
                                                <Setter Property="FontSize" Value="17" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding FileName}" FontSize="11"
                                           LineBreakMode="MiddleTruncation"
                                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNormalMode}" Value="True">
                                                <Setter Property="FontSize" Value="12" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding StateText}" FontSize="11"
                                           TextColor="{Binding StateColor}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsNormalMode}" Value="True">
                                                <Setter Property="FontSize" Value="12" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding IssueText}" FontSize="11"
                                           IsVisible="{Binding HasIssue}"
                                           LineBreakMode="CharacterWrap"
                                           TextColor="{Binding IssueColor}" />
                                    <Label Text="{Binding ConflictText}" FontSize="11"
                                           IsVisible="{Binding HasConflict}"
                                           LineBreakMode="CharacterWrap"
                                           TextColor="#C62828" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center"
                                                     IsVisible="{Binding IsNormalMode}">
                                    <Switch VerticalOptions="Center"
                                            IsToggled="{Binding Enabled, Mode=OneWay}"
                                            Toggled="OnModToggled" />
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                        <Button Text="↑" FontSize="13" Padding="0" CornerRadius="6"
                                                HeightRequest="28" WidthRequest="36"
                                                Clicked="OnMoveUpClicked" IsEnabled="{Binding CanMoveUp}" />
                                        <Button Text="↓" FontSize="13" Padding="0" CornerRadius="6"
                                                HeightRequest="28" WidthRequest="36"
                                                Clicked="OnMoveDownClicked" IsEnabled="{Binding CanMoveDown}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="3" IsVisible="False"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="True" Color="White"
                               VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
