<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoLLauncher.Maui.Settings.AppearanceSettingsPage"
             Title="界面与外观">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="主题" Style="{StaticResource SettingsItemTitle}" />
                    <Label Style="{StaticResource SettingsHint}"
                           Text="切换整个界面的配色；跟随系统时随 Android 的亮色 / 深色设置自动变化。" />
                    <Picker x:Name="ThemePicker" FontSize="12" Margin="0,6,0,0"
                            SelectedIndexChanged="OnThemeChanged" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="主题色" Style="{StaticResource SettingsItemTitle}" />
                    <Label Style="{StaticResource SettingsHint}"
                           Text="自定义强调色（按钮、选中态、标题等）。点色块快速选择，或用色相 / 饱和度 / 亮度滑块微调；饱和度 100% 为程序推荐的鲜艳度。" />

                    <HorizontalStackLayout Spacing="10" Margin="0,6,0,0">
                        <Border x:Name="AccentChip" WidthRequest="36" HeightRequest="36"
                                StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                BackgroundColor="{DynamicResource AccentColor}" VerticalOptions="Center" />
                        <Label x:Name="AccentHexLabel" Style="{StaticResource SettingsHint}"
                               VerticalOptions="Center" />
                        <Button Text="恢复默认" FontSize="12" Padding="10,4" CornerRadius="8"
                                HeightRequest="32" VerticalOptions="Center" Clicked="OnAccentReset"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                    </HorizontalStackLayout>

                    <FlexLayout x:Name="PresetRow" Wrap="Wrap" Direction="Row" Margin="0,10,0,0" />

                    <Label Text="色相" Style="{StaticResource SettingsHint}" Margin="0,10,0,0" />
                    <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
                        <Slider x:Name="HueSlider" Grid.Column="0" Minimum="0" Maximum="360"
                                ValueChanged="OnHslChanged" DragCompleted="OnHslDragCompleted" />
                        <Label x:Name="HueText" Grid.Column="1" Style="{StaticResource SettingsHint}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="饱和度" Style="{StaticResource SettingsHint}" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
                        <Slider x:Name="SaturationSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                ValueChanged="OnHslChanged" DragCompleted="OnHslDragCompleted" />
                        <Label x:Name="SaturationText" Grid.Column="1" Style="{StaticResource SettingsHint}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="亮度" Style="{StaticResource SettingsHint}" Margin="0,8,0,0" />
                    <Grid ColumnDefinitions="*,48" ColumnSpacing="8">
                        <Slider x:Name="LightnessSlider" Grid.Column="0" Minimum="0" Maximum="100"
                                ValueChanged="OnHslChanged" DragCompleted="OnHslDragCompleted" />
                        <Label x:Name="LightnessText" Grid.Column="1" Style="{StaticResource SettingsHint}"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="玩家头像" Style="{StaticResource SettingsItemTitle}" />
                    <Label Style="{StaticResource SettingsHint}"
                           Text="显示在主界面的圆形头像。可选择本地图片（PNG / JPG / BMP / GIF，8 MB 以内）。" />

                    <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
                        <Border WidthRequest="72" HeightRequest="72" StrokeThickness="0"
                                StrokeShape="RoundRectangle 36"
                                BackgroundColor="{DynamicResource AccentPaleColor}">
                            <Grid>
                                <Label x:Name="AvatarPlaceholder" Text="头像" FontSize="12"
                                       TextColor="{DynamicResource AccentColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image x:Name="AvatarImage" Aspect="AspectFill" IsVisible="False" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                            <Button Text="上传头像" FontSize="12" Padding="10,4" CornerRadius="8"
                                    HeightRequest="34" Clicked="OnAvatarUpload"
                                    BackgroundColor="{DynamicResource AccentColor}"
                                    TextColor="{DynamicResource AccentOnColor}" />
                            <Button Text="恢复默认" FontSize="12" Padding="10,4" CornerRadius="8"
                                    HeightRequest="34" Clicked="OnAvatarReset"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label x:Name="AvatarStatusLabel" Style="{StaticResource SettingsHint}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="启动器副标题" Style="{StaticResource SettingsItemTitle}" />
                    <Label Style="{StaticResource SettingsHint}"
                           Text="显示在主界面「DoL 启动器」下方的一行小字；留空时使用「版本 · 模组 · 存档」。" />
                    <Entry x:Name="SubtitleEntry" FontSize="14" MaxLength="32" Margin="0,4,0,0"
                           Unfocused="OnSubtitleUnfocused" Completed="OnSubtitleUnfocused" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <Label Text="启用界面过渡动画" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="页面切换与列表刷新使用平滑过渡；该开关会写入配置，供后续页面统一读取。" />
                    </VerticalStackLayout>
                    <Switch x:Name="AnimSwitch" Grid.Column="1" VerticalOptions="Center"
                            Toggled="OnAnimToggled" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
