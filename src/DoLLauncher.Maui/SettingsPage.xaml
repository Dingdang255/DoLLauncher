<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoLLauncher.Maui.SettingsPage"
             Title="设置">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="14">

            <!-- 外观 -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="外观" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="主题模式" FontSize="15" />
                            <Label Text="跟随系统，或强制使用亮色 / 深色" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        </VerticalStackLayout>
                        <Picker x:Name="ThemePicker" Grid.Column="1" WidthRequest="150"
                                VerticalOptions="Center" SelectedIndexChanged="OnThemeChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 日志 -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="日志" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="日志详细度" FontSize="15" />
                            <Label Text="详细模式会在错误日志里附带完整堆栈" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        </VerticalStackLayout>
                        <Picker x:Name="LogPicker" Grid.Column="1" WidthRequest="150"
                                VerticalOptions="Center" SelectedIndexChanged="OnLogChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 游戏 -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="游戏" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="关闭页面后" FontSize="15" />
                            <Label Text="退出游戏页面时是否先确认停止服务器" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        </VerticalStackLayout>
                        <Picker x:Name="ClosePicker" Grid.Column="1" WidthRequest="150"
                                VerticalOptions="Center" SelectedIndexChanged="OnCloseChanged" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="游戏本体下载源" FontSize="15" />
                            <Label Text="下载中心使用的游戏本体来源" FontSize="11"
                                   TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                        </VerticalStackLayout>
                        <Picker x:Name="SourcePicker" Grid.Column="1" WidthRequest="150"
                                VerticalOptions="Center" SelectedIndexChanged="OnSourceChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 关于 -->
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F2, Dark=#2A2A2A}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="关于" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />

                    <VerticalStackLayout Spacing="3">
                        <Label Text="启动器根目录" FontSize="15" />
                        <Label x:Name="RootLabel" FontSize="12"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="应用版本" FontSize="15" VerticalOptions="Center" />
                        <Label x:Name="VersionLabel" Grid.Column="1" FontSize="13"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#A0A0A0}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
