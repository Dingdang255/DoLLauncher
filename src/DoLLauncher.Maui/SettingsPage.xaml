<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DoLLauncher.Maui"
             x:Class="DoLLauncher.Maui.SettingsPage"
             Title="设置">

    <ScrollView>
        <Grid Padding="16,12,16,20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="10">

            <Label Grid.Row="0" Grid.ColumnSpan="2" Text="选择一个分类查看相关设置。"
                   Style="{StaticResource SettingsHint}" Margin="2,0,0,4" />

            <!-- 网络下载 -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="网络下载" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.ArrowDownload}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="网络下载" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="模组下载源、GitHub 接口源与游戏本体来源：选择下载和访问接口时走的线路。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 数据与索引 -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="数据与索引" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.Database}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="数据与索引" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="模组市场索引源、启动时预取索引，以及是否把补全的作者 / 主页写回模组包。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 问题检查 -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="问题检查" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.CheckmarkCircle}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="问题检查" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="游戏版本差异告警阈值：决定「可能存在问题」里版本不匹配的敏感度。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 游戏 -->
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="游戏" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.Play}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="游戏" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="关闭页面后的处理与关页检测（心跳、超时、宽限、防抖）时间参数。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 界面与外观 -->
            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="界面与外观" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.PaintBrush}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="界面与外观" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="主题、主题色、玩家头像、启动器副标题与界面过渡动画，修改后立即生效。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 日志与诊断 -->
            <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="日志与诊断" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.Notebook}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="日志与诊断" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="日志详细度、游戏日志保留 / 上限 / 超限策略、上报队列与清空 Mod 缓存。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 版本信息 -->
            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="版本信息" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.Info}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="版本信息" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="启动器版本、提交与构建时间、自动检测更新开关与致谢名单。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 关于 -->
            <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingsCard}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="关于" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeThickness="0"
                            StrokeShape="RoundRectangle 9" VerticalOptions="Center"
                            BackgroundColor="{DynamicResource AccentPaleColor}">
                        <Label Text="{x:Static local:IconGlyph.QuestionCircle}" FontFamily="FluentIcons"
                               FontSize="18" TextColor="{DynamicResource AccentColor}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="关于" Style="{StaticResource SettingsItemTitle}" />
                        <Label Style="{StaticResource SettingsHint}"
                               Text="应用信息、应用根目录、项目主页与反馈入口。" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static local:IconGlyph.ChevronRight}"
                           FontFamily="FluentIcons" FontSize="12" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B0B0B0, Dark=#808080}" />
                </Grid>
            </Border>

            <!-- 运行记录 -->
            <Border Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource SettingsCard}" Margin="0,4,0,0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleLog" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="运行记录" Style="{StaticResource SettingsItemTitle}" />
                            <Label Text="最近 200 行启动器日志，展开后可清屏。" Style="{StaticResource SettingsHint}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Button Text="清屏" FontSize="12" Padding="8,2" CornerRadius="8"
                                    HeightRequest="30" Clicked="OnClearLog"
                                    BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3C3C3C}"
                                    TextColor="{AppThemeBinding Light=#333333, Dark=#E8E8E8}" />
                            <Button x:Name="LogToggleButton" Text="展开" FontSize="12" Padding="8,2"
                                    CornerRadius="8" HeightRequest="30" Clicked="OnToggleLogClicked"
                                    BackgroundColor="{DynamicResource AccentPaleColor}"
                                    TextColor="{DynamicResource AccentColor}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Editor x:Name="LogEditor" IsVisible="False" IsReadOnly="True"
                            HeightRequest="180" FontSize="11" AutoSize="Disabled"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}" />
                </VerticalStackLayout>
            </Border>

        </Grid>
    </ScrollView>

</ContentPage>
